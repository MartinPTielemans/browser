    # The keyboard's layouts, for keyboard.mm.
    frameworks = [ "Carbon.framework" ]
    # WebKit isn't linked: system_page.mm starts it with the first system page, so a launch that
    # shows none starts no WebKit process.
    deps += [
      "//chrome/browser:chrome_browser_application_mac",
      "//components/os_crypt/common:keychain_password_mac",
