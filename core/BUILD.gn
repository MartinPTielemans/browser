# The core's tests that run without the browser. engine/linux/build.sh builds them, and the Linux
# engine's run runs them.
test("browser_core_unittests") {
  sources = [
    "search_default_unittest.cc",
    "space_default_unittest.cc",
    "sync_guard_unittest.cc",
    "sync_pairing_unittest.cc",
  ]
  deps = [
    ":search_default",
    ":space_default",
    ":sync_guard",
    ":sync_keys",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//components/search_engines",
    "//components/search_engines:test_support",
    "//components/sync",
    "//components/sync/protocol",
    "//components/sync_preferences:test_support",
    "//components/variations:test_support",
    "//testing/gtest",
  ]
  if (use_xkbcommon) {
    sources += [ "xkb_no_keymap_unittest.cc" ]
    deps += [
      "//ui/events:dom_keycode_converter",
      "//ui/events/ozone/layout",
    ]
  }
}
