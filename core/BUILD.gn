# Our layer in Chrome's framework (docs/decisions.md, decision 3). engine/setup.sh links this
# directory into the tree as //browser_core, and engine/patches/ours/chromium-core-link.patch links
# it into the framework.

import("//build/config/sanitizers/sanitizers.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//testing/test.gni")
import("//third_party/protobuf/proto_library.gni")
import("//ui/base/ui_features.gni")

# What a page tells the core about the key system it asks for. Blink's encrypted media module calls
# it (engine/patches/ours/chromium-drm-request.patch), so it has a Blink variant.
mojom("drm_request") {
  sources = [ "drm_request.mojom" ]
  generate_blink = true
}

# The page a tab shows for a load that failed. Chrome's renderer calls it
# (engine/patches/ours/chromium-core-error-page.patch), so it's apart from the browser's code.
source_set("error_page") {
  sources = [
    "error_page.cc",
    "error_page.h",
  ]
  deps = [ "//base" ]
}

# What keeps DuckDuckGo a profile's default and not its choice, apart from the browser's code so its
# test links without the browser.
source_set("search_default") {
  sources = [
    "search_default.cc",
    "search_default.h",
  ]
  deps = [
    "//base",
    "//components/pref_registry",
    "//components/prefs",
    "//components/search_engines",
  ]
}

# What the Spaces sync type's entities hold (sync_spaces.cc).
proto_library("sync_spaces_proto") {
  sources = [ "sync_spaces.proto" ]
}

config("exports") {
  # The framework exports only what chrome/app/framework.exports lists. This adds the C API.
  ldflags = [ "-Wl,-exported_symbols_list," + rebase_path("exports.txt", root_build_dir) ]
}

config("linux_exports") {
  # On Linux the core is in the chrome executable, which exports nothing unless asked: the app
  # library it loads (platform/linux/app_library.cc) calls the C API from there.
  # engine/patches/ours/chromium-core-link-linux.patch lists it in chrome.map too.
  # So is libwayland's client API, Chromium's copy, which the app's UI calls on Chromium's display
  # (platform/linux/wayland.cc).
  ldflags = [
    "-Wl,--export-dynamic-symbol=bc_*",
    "-Wl,--export-dynamic-symbol=wl_*",
  ]
}

config("app_calls") {
  # Clang's indirect-call check, on in official Linux builds, traps on the core's calls into the
  # app (cfi_ignores.txt says why and how).
  if (is_cfi) {
    cflags = [ "-fsanitize-ignorelist=" + rebase_path("cfi_ignores.txt", root_build_dir) ]
    inputs = [ "cfi_ignores.txt" ]
  }
}

# The account secret's words and pairing's cryptography and rules, which need no browser, so
# browser_core_unittests tests them alone.
source_set("sync_keys") {
  sources = [
    "sync_pairing.cc",
    "sync_pairing.h",
    "sync_words.cc",
    "sync_words.h",
    "sync_words_list.cc",
  ]
  deps = [
    "//base",
    "//crypto",
    "//third_party/boringssl",
  ]
}

# What the account's sync lets go to its server, on sync's own sequences, apart so
# browser_core_unittests tests it alone.
source_set("sync_guard") {
  sources = [
    "sync_guard.cc",
    "sync_guard.h",
  ]
  deps = [
    ":sync_keys",
    "//base",
    "//components/sync",
    "//components/sync/protocol",
    "//crypto",
  ]
}

# Whether a device's first Space gives way to the account's, apart so browser_core_unittests
# tests the rule alone.
source_set("space_default") {
  sources = [
    "space_default.cc",
    "space_default.h",
  ]
}

