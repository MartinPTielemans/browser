# Our layer in Chrome's framework (docs/decisions.md, decision 3). engine/setup.sh links this
# directory into the tree as //browser_core, and engine/patches/ours/chromium-core-link.patch links
# it into the framework.

import("//build/config/sanitizers/sanitizers.gni")
import("//mojo/public/tools/bindings/mojom.gni")

# What a page tells the core about the key system it asks for. Blink's encrypted media module calls
# it (engine/patches/ours/chromium-drm-request.patch), so it has a Blink variant.
mojom("drm_request") {
  sources = [ "drm_request.mojom" ]
  generate_blink = true
}

# The page a tab shows for a load that failed. Chrome's renderer calls it
# (engine/patches/ours/chromium-core-error-page.patch), so it's apart from the browser's code.
source_set("error_page") {
  sources = [
    "error_page.cc",
    "error_page.h",
  ]
  deps = [ "//base" ]
}

config("exports") {
  # The framework exports only what chrome/app/framework.exports lists. This adds the C API.
  ldflags = [ "-Wl,-exported_symbols_list," + rebase_path("exports.txt", root_build_dir) ]
}

