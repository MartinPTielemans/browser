# Our layer in Chrome's framework (docs/decisions.md, decision 3). engine/setup.sh links this
# directory into the tree as //browser_core, and engine/patches/ours/chromium-core-link.patch links
# it into the framework.

import("//build/config/sanitizers/sanitizers.gni")

config("exports") {
  # The framework exports only what chrome/app/framework.exports lists. This adds the C API.
  ldflags = [ "-Wl,-exported_symbols_list," + rebase_path("exports.txt", root_build_dir) ]
}

source_set("browser_core") {
  sources = [
    "api.cc",
    "archive.cc",
    "archive.h",
    "auto_archive.cc",
    "auto_archive.h",
    "browser_window_stand_in.cc",
    "browser_window_stand_in.h",
    "clear_site.cc",
    "clear_site.h",
    "downloads.cc",
    "downloads.h",
    "extensions.cc",
    "extensions.h",
    "favicon.cc",
    "favicon.h",
    "favorites.cc",
    "favorites.h",
    "find.cc",
    "find.h",
    "hooks.h",
    "host.h",
    "main_delegate.cc",
    "main_delegate.h",
    "platform/window_views.h",
    "popular_sites.cc",
    "popular_sites.h",
    "profiles.cc",
    "profiles.h",
    "public/browser_core.h",
    "search.cc",
    "search.h",
    "session.cc",
    "session.h",
    "space.cc",
    "space.h",
    "suggest.cc",
    "suggest.h",
    "tab.cc",
    "tab.h",
    "window.cc",
    "window.h",
  ]

  deps = [
    "//base",
    "//chrome/app:command_ids",
    "//chrome/browser",
    "//chrome/browser:chrome_browser_main",
    "//chrome/browser:chrome_content_browser_client",
    "//chrome/browser:main_extra_parts",
    "//chrome/browser/autocomplete",
    "//chrome/browser/devtools",
    "//chrome/browser/download",
    "//chrome/browser/extensions",
    "//chrome/browser/favicon",
    "//chrome/browser:icon_loader",
    "//chrome/browser:icon_manager",
    "//chrome/browser/lifetime",
    "//chrome/browser/lifetime:termination_notification",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui",
    "//chrome/browser/ui:browser_tabrestore",
    "//chrome/browser/ui:recently_audible_helper",
    "//chrome/browser/ui/autofill",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/find_bar",
    "//chrome/browser/ui/interaction",
    "//chrome/browser/ui/location_bar",
    "//chrome/browser/ui/tabs:utils",
    "//chrome/browser/ui/views:bubble_anchor_util_views",
    "//chrome/browser/ui/views/extensions:extension_popup",
    "//chrome/browser/ui/views/eye_dropper",
    "//chrome/browser/ui/views/interaction:impl",
    "//chrome/common",
    "//chrome/common/profiler",
    "//components/download/content/public",
    "//components/download/public/common:public",
    "//components/favicon/content",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/keyed_service/core",
    "//components/find_in_page",
    "//components/input",
    "//components/keep_alive_registry",
    "//components/omnibox/browser",
    "//components/search_engines",
    "//components/sessions",
    "//components/tabs:public",
    "//components/url_formatter",
    "//components/web_modal",
    "//components/zoom",
    "//content/public/browser",
    "//content/public/common",
    "//extensions/browser",
    "//extensions/common",
    "//net",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/events:dom_keycode_converter",
    "//ui/events:events_base",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
    "//ui/menus",
    "//ui/native_theme",
    "//ui/views",
    "//ui/views/controls/webview",
    "//url",
  ]

  if (is_mac) {
    sources += [
      "platform/mac/native_widget.mm",
      "platform/mac/window_views.mm",
    ]
    deps += [
      "//components/remote_cocoa/app_shim",
      "//components/remote_cocoa/common:mojo",
    ]
    # Only where Chrome lists the framework's exports (chrome/BUILD.gn): on its own, this list
    # would be the only one, and hide ChromeMain. Elsewhere the API's visibility exports it.
    if (!is_component_build && !using_sanitizer) {
      all_dependent_configs = [ ":exports" ]
    }
  }
}
