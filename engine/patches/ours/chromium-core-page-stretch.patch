+// browser_core: lets the core keep a page's still edge still while the app moves the other.
+
+#ifndef CONTENT_PUBLIC_BROWSER_STRETCH_CONTENT_ON_RESIZE_MAC_H_
+#define CONTENT_PUBLIC_BROWSER_STRETCH_CONTENT_ON_RESIZE_MAC_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+class RenderWidgetHostView;
+
+// Whether |view|'s resizes from now on stretch the frame it last drew to fill it until the
+// renderer draws at the new size, rather than show that frame at its old size in the top-left
+// corner, which moves the page's right edge and scrollbar with its left edge.
+CONTENT_EXPORT void SetStretchContentOnResize(RenderWidgetHostView* view, bool stretch);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_STRETCH_CONTENT_ON_RESIZE_MAC_H_
