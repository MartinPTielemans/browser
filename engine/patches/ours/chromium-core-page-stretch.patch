+
+void SetStretchContentOnResize(RenderWidgetHostView* view, bool stretch) {
+  // A frame's view in its page draws in the page's surface, which stretches with it.
+  if (!view || static_cast<RenderWidgetHostViewBase*>(view)
+                   ->IsRenderWidgetHostViewChildFrame()) {
+    return;
+  }
+  BrowserCompositorMac* compositor =
+      static_cast<RenderWidgetHostViewMac*>(view)->BrowserCompositor();
+  if (compositor && compositor->GetDelegatedFrameHost()) {
+    compositor->GetDelegatedFrameHost()->SetStretchContentOnResize(stretch);
+  }
 }
 
