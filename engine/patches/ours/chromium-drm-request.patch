+// browser_core: tells the browser that |window|'s page asked for |key_system|, in
+// //browser_core/drm_request.mojom. The browser decides what it means; nothing is said back.
+void ReportKeySystemRequest(LocalDOMWindow* window, const String& key_system) {
+  if (!window || !window->GetFrame()) {
+    return;
+  }
+  mojo::Remote<browser_core::mojom::blink::DrmRequest> request;
+  window->GetFrame()->GetBrowserInterfaceBroker().GetInterface(
+      request.BindNewPipeAndPassReceiver());
+  request->KeySystemRequested(key_system);
+}
