Keeps a crashed page from taking the browser down in the core's windows. Chrome puts its
"Aw, Snap!" view into the page's BrowserView, which the core's windows don't have, and found
none with a DCHECK and then a null dereference.

--- a/chrome/browser/ui/sad_tab_controller.cc
+++ b/chrome/browser/ui/sad_tab_controller.cc
@@ -29,7 +29,10 @@
     return nullptr;
   }
   BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
-  DCHECK(browser_view);
+  // browser_core: the core's windows aren't BrowserViews, so a crashed page there has no view.
+  if (!browser_view) {
+    return nullptr;
+  }
 
   for (auto* contents_view : browser_view->GetAllVisibleContentsWebViews()) {
     if (contents_view->web_contents() == web_contents) {
