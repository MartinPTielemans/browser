Shows the core's page for a load that failed (//browser_core/error_page.h) in place of
Chromium's, from the strings Chromium made for its own: ilo's look, with no game. The rest of
Chromium's error page machinery stays: its helper's reload button calls, its DNS probe update and
the browser's auto-reload once the network is back. Pages from other templates, such as an
offline web app's, keep theirs.

--- a/chrome/renderer/BUILD.gn
+++ b/chrome/renderer/BUILD.gn
@@ -127,6 +127,7 @@
 
   deps = [
     ":process_state",
+    "//browser_core:error_page",
     "//base/allocator:buildflags",
     "//build:chromeos_buildflags",
     "//chrome:resources",
--- a/chrome/renderer/net/DEPS
+++ b/chrome/renderer/net/DEPS
@@ -1,4 +1,5 @@
 include_rules = [
+  "+browser_core/error_page.h",
   "+components/error_page/renderer",
   "+components/offline_pages/core",
   "+components/security_interstitials/core",
--- a/chrome/renderer/net/net_error_helper.cc
+++ b/chrome/renderer/net/net_error_helper.cc
@@ -3,6 +3,7 @@
 // found in the LICENSE file.
 
 #include "chrome/renderer/net/net_error_helper.h"
+#include "browser_core/error_page.h"  // nogncheck
 
 #include <memory>
 #include <string>
@@ -226,6 +227,12 @@
         IsExtensionExtendedErrorCode(error.extended_reason()),
         &error_page_params_);
   }
+  if (resource_id == IDR_NET_ERROR_HTML) {
+    // browser_core: the core's page, from the same strings
+    // (//browser_core/error_page.h).
+    *error_html = browser_core::ErrorPageHtml(page_state.strings);
+    return page_state;
+  }
   std::string template_html =
       ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
           resource_id);
