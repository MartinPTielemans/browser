Lets the core turn on password generation with no Google account, which Chrome requires only to
sync the password; the core's profiles keep it on this device. A hook only: the core sets it
(//browser_core/password_offer.cc).
--- a/components/password_manager/core/browser/password_generation_frame_helper.cc
+++ b/components/password_manager/core/browser/password_generation_frame_helper.cc
@@ -37,6 +37,11 @@
 using autofill::FormSignature;
 using autofill::password_generation::PasswordGenerationType;
 
+// browser_core: Chrome generates passwords only for a Google account that
+// syncs them, which the core's profiles don't have; the core lets it generate
+// them for the device's own store (//browser_core/hooks.h).
+bool g_browser_core_generates_passwords = false;
+
 namespace password_manager {
 
 namespace {
@@ -132,7 +137,8 @@
     return false;
   }
 
-  if (client_->GetPasswordFeatureManager()->IsGenerationEnabled()) {
+  if (client_->GetPasswordFeatureManager()->IsGenerationEnabled() ||
+      g_browser_core_generates_passwords) {
     return true;
   }
