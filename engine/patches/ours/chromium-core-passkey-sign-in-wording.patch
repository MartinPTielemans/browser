Lets the core keep Chrome's passkey dialog from mentioning Incognito windows in a page it keeps
off the record for itself, such as the ilo account's sign-in window (//browser_core/hooks.h).
Chrome picks the dialog's Incognito wording, and on Windows and Linux an interstitial before the
device's own authenticator, from whether the page's profile is off the record. A profile the core
makes for one page of its own is no Incognito window the user opened, and the passkey is the
authenticator's, kept as in the original profile either way.

--- a/chrome/browser/webauthn/chrome_authenticator_request_delegate.cc
+++ b/chrome/browser/webauthn/chrome_authenticator_request_delegate.cc
@@ -131,6 +131,11 @@
 bool (*g_browser_core_refuse_passkey)(content::WebContents* contents,
                                       bool asks) = nullptr;
 
+// browser_core: an off-the-record page whose passkey dialog reads as a normal
+// window's (//browser_core/hooks.h).
+bool (*g_browser_core_passkey_normal_wording)(content::WebContents* contents) =
+    nullptr;
+
 namespace {
 
 ChromeAuthenticatorRequestDelegate::TestObserver* g_observer = nullptr;
@@ -1331,6 +1336,15 @@
       tai.available_transports.contains(
           device::FidoTransportProtocol::kUsbHumanInterfaceDevice);
   dialog_model_->is_off_the_record = GetBrowserContext()->IsOffTheRecord();
+  // browser_core: a profile the core keeps off the record for one page of its
+  // own, such as the ilo account's sign-in, is no Incognito window the user
+  // opened.
+  if (dialog_model_->is_off_the_record &&
+      g_browser_core_passkey_normal_wording &&
+      g_browser_core_passkey_normal_wording(
+          content::WebContents::FromRenderFrameHost(GetRenderFrameHost()))) {
+    dialog_model_->is_off_the_record = false;
+  }
   dialog_model_->platform_has_biometrics = tai.platform_has_biometrics;
 }
 
