Lets the core offer to save an address with the app's prompt (//browser_core/autofill_offer.h).
Chrome finds the window's autofill bubble handler through its BrowserView, which the core's
windows don't have, and dereferenced the null it found as the form was submitted. The core's
windows put their handler on the tab's window instead, where Chrome's card offer finds it, and
offer no iOS promo once the address is saved.

--- a/chrome/browser/ui/autofill/address_bubbles_controller.cc
+++ b/chrome/browser/ui/autofill/address_bubbles_controller.cc
@@ -43,12 +43,27 @@
 #include "components/signin/public/identity_manager/account_info.h"
 #include "components/strings/grit/components_strings.h"
 #include "components/sync/base/user_selectable_type.h"
+#include "components/tabs/public/tab_interface.h"
 #include "ui/base/l10n/l10n_util.h"
 
 namespace autofill {
 
 namespace {
 
+AutofillBubbleHandler* BubbleHandler(content::WebContents* web_contents) {
+  if (BrowserWindow* window =
+          BrowserWindow::FindBrowserWindowWithWebContents(web_contents)) {
+    return window->GetAutofillBubbleHandler();
+  }
+  // browser_core: the core's windows aren't BrowserViews, so the handler is
+  // found through the tab's window, as the card offer finds it
+  // (//browser_core/browser_window_stand_in.h).
+  return AutofillBubbleHandler::Get(
+      tabs::TabInterface::GetFromContents(web_contents)
+          ->GetBrowserWindowInterface()
+          ->GetUnownedUserDataHost());
+}
+
