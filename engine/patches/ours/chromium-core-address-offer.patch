Lets the core's windows, which have no BrowserView, take a submitted address: Chrome finds a tab's
window for the address offers by its BrowserView, which is null for the core's tabs, so the core
gives the autofill bubble handler of its tab's window (g_browser_core_autofill_bubble_handler).
Accepting the offer runs the iOS promo's check, which reads the BrowserView too; the core's windows
have no promo for Chrome on iOS.

--- a/chrome/browser/ui/autofill/address_bubbles_controller.cc
+++ b/chrome/browser/ui/autofill/address_bubbles_controller.cc
@@ -45,10 +45,27 @@
 #include "components/sync/base/user_selectable_type.h"
 #include "ui/base/l10n/l10n_util.h"
 
+// browser_core: see browser_core/hooks.h.
+autofill::AutofillBubbleHandler* (*g_browser_core_autofill_bubble_handler)(
+    content::WebContents* web_contents) = nullptr;
+
 namespace autofill {
 
 namespace {
 
+// browser_core: Chrome finds a tab's window by its BrowserView, which the
+// core's windows don't have, so the core gives the handler of its tab's window.
+AutofillBubbleHandler* BubbleHandlerFor(content::WebContents* web_contents) {
+  if (g_browser_core_autofill_bubble_handler) {
+    if (AutofillBubbleHandler* handler =
+            g_browser_core_autofill_bubble_handler(web_contents)) {
+      return handler;
+    }
+  }
+  return BrowserWindow::FindBrowserWindowWithWebContents(web_contents)
+      ->GetAutofillBubbleHandler();
+}
