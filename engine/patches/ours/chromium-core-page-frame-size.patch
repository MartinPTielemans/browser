@@ -0,0 +1,19 @@
+// browser_core: lets the core hold the window's commit until a moving page has drawn at its size.
+
+#ifndef CONTENT_PUBLIC_BROWSER_FRAME_AT_VIEW_SIZE_MAC_H_
+#define CONTENT_PUBLIC_BROWSER_FRAME_AT_VIEW_SIZE_MAC_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+class RenderWidgetHostView;
+
+// Whether |view| shows a frame its browser compositor drew at the view's size, or has nothing to
+// wait for: a frame's view in its page, or a view that hasn't drawn. Until it has, AppKit shows
+// the last frame at its old size in the view's top-left corner.
+CONTENT_EXPORT bool HasFrameAtViewSize(RenderWidgetHostView* view);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_FRAME_AT_VIEW_SIZE_MAC_H_
