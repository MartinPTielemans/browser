+bool HasFrameAtViewSize(RenderWidgetHostView* view) {
+  // A frame's view in its page draws in the page's frame.
+  if (!view || static_cast<RenderWidgetHostViewBase*>(view)
+                   ->IsRenderWidgetHostViewChildFrame()) {
+    return true;
+  }
+  BrowserCompositorMac* compositor =
+      static_cast<RenderWidgetHostViewMac*>(view)->BrowserCompositor();
+  const gfx::CALayerParams* frame =
+      compositor ? compositor->GetLastCALayerParams() : nullptr;
+  if (!frame) {
+    return true;
+  }
+  // As ui::AcceleratedWidgetMac::HasFrameOfSize and Chrome's windows compare.
+  return gfx::ToFlooredSize(gfx::ConvertSizeToDips(
+             frame->pixel_size, frame->scale_factor)) ==
+         compositor->GetRendererSize();
+}
+
 }  // namespace content
