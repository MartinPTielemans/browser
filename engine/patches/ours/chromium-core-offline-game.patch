+void NetErrorAutoReloader::SetHeld(bool held) {
+  held_ = held;
+  if (held) {
+    reload_held_ |= next_reload_timer_.has_value();
+    PauseAutoReloadTimerIfRunning();
+  } else if (std::exchange(reload_held_, false) &&
+             current_reloadable_error_page_info_ &&
+             pending_navigations_.empty()) {
+    ReloadMainFrame();
   }
 }
 
