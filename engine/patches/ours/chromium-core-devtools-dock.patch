Lets the core dock DevTools in its windows (//browser_core/hooks.h), which have none of Chrome's
views, and so no DevtoolsUIController to dock them in.

--- a/chrome/browser/devtools/devtools_window.cc
+++ b/chrome/browser/devtools/devtools_window.cc
@@ -3,6 +3,7 @@
 // found in the LICENSE file.
 
 #include "chrome/browser/devtools/devtools_window.h"
+#include "browser_core/hooks.h"  // nogncheck
 
 #include <algorithm>
 #include <memory>
@@ -137,6 +138,13 @@
 using content::GlobalRenderFrameHostId;
 using content::WebContents;
 
+// browser_core: the core docks DevTools in its windows (//browser_core/hooks.h).
+bool (*g_browser_core_can_dock_devtools)(BrowserWindowInterface* browser) = nullptr;
+void (*g_browser_core_update_devtools)(BrowserWindowInterface* browser,
+                                       content::WebContents* inspected) = nullptr;
+void (*g_browser_core_show_devtools)(BrowserWindowInterface* browser,
+                                     content::WebContents* inspected) = nullptr;
+
 namespace {
 
 typedef std::vector<DevToolsWindow*> DevToolsWindows;
@@ -1075,16 +1083,26 @@
         FROM_HERE, base::BindOnce(&DevToolsWindow::ActivateInspectedTab,
                                   weak_factory_.GetWeakPtr()));
 
+    // browser_core: the core docks DevTools in its windows, and gives them the
+    // keyboard itself once the page no longer covers them.
+    bool core_docks = false;
     if (auto* devtools_ui_controller =
             DevtoolsUIController::From(inspected_browser)) {
       devtools_ui_controller->UpdateDevtools(inspected_web_contents);
+    } else if (g_browser_core_show_devtools) {
+      g_browser_core_show_devtools(inspected_browser, inspected_web_contents);
+      core_docks = true;
+    }
+    if (!core_docks) {
+      main_web_contents_->SetInitialFocus();
     }
-    main_web_contents_->SetInitialFocus();
     inspected_window->Show();
     // On Aura, focusing once is not enough. Do it again.
     // Note that focusing only here but not before isn't enough either. We just
     // need to focus twice.
-    main_web_contents_->SetInitialFocus();
+    if (!core_docks) {
+      main_web_contents_->SetInitialFocus();
+    }
 
     PrefsTabHelper::CreateForWebContents(main_web_contents_);
     OverrideAndSyncDevToolsRendererPrefs();
@@ -1402,7 +1420,11 @@
 #endif  // BUILDFLAG(IS_MAC)
     DevtoolsUIController* devtools_ui_controller =
         browser ? DevtoolsUIController::From(browser) : nullptr;
-    if (!devtools_ui_controller || !devtools_ui_controller->CanDockDevtools()) {
+    // browser_core: or the core docks them in its window.
+    if ((!devtools_ui_controller ||
+         !devtools_ui_controller->CanDockDevtools()) &&
+        !(browser && g_browser_core_can_dock_devtools &&
+          g_browser_core_can_dock_devtools(browser))) {
       can_dock = false;
     }
   }
--- a/chrome/browser/devtools/devtools_window_views.cc
+++ b/chrome/browser/devtools/devtools_window_views.cc
@@ -2,6 +2,7 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#include "browser_core/hooks.h"  // nogncheck
 #include "chrome/browser/devtools/devtools_ui_controller.h"
 #include "chrome/browser/devtools/devtools_window.h"
 #include "chrome/browser/ui/browser_window.h"
@@ -138,6 +139,9 @@
   if (auto* devtools_ui_controller =
           DevtoolsUIController::From(inspected_browser)) {
     devtools_ui_controller->UpdateDevtools(inspected_web_contents);
+  } else if (g_browser_core_update_devtools) {
+    // browser_core: the core docks DevTools in its windows.
+    g_browser_core_update_devtools(inspected_browser, inspected_web_contents);
   }
 }
 
