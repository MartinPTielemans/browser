+// browser_core: the app shows a page's menu in its own (//browser_core/hooks.h).
+std::unique_ptr<RenderViewContextMenuBase> (*g_browser_core_show_page_menu)(
+    content::WebContents* contents,
+    std::unique_ptr<RenderViewContextMenuBase> menu) = nullptr;
+
 ChromeWebContentsViewDelegateViewsMac::ChromeWebContentsViewDelegateViewsMac(
     content::WebContents* web_contents)
     : ContextMenuDelegate(web_contents),
@@ -194,6 +200,13 @@
 
 void ChromeWebContentsViewDelegateViewsMac::ShowMenu(
     std::unique_ptr<RenderViewContextMenuBase> menu) {
+  if (g_browser_core_show_page_menu && menu) {
+    // browser_core: takes the menu to show in the app's own.
+    menu = g_browser_core_show_page_menu(web_contents_, std::move(menu));
+    if (!menu) {
+      return;
+    }
+  }
   context_menu_ = std::move(menu);
   if (!context_menu_.get()) {
     return;
