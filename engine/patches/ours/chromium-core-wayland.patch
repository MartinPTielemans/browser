     configs += [
-      ":wayland_build_workaround_hide_symbols",
+      # browser_core: kept visible, so chrome can export libwayland's client API (chrome.map).
       ":wayland_build_workaround_private_config",
       "//build/config/compiler:no_chromium_code",
       "//build/config/linux/libffi",
     ]
 
     public_configs = [ ":wayland_config" ]
+
+    # browser_core: the app's UI, in a library chrome loads, shares this copy, whose dispatch calls
+    # the UI's handlers there, which Clang's indirect-call check traps on.
+    cflags = [ "-fno-sanitize=cfi-icall" ]
   }
 
