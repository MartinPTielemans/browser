+++ b/build/linux/chrome.map
@@ -115,6 +115,10 @@ global:
   # The core's C API, for the app the core loads (browser_core/platform/linux/app_library.cc).
   bc_*;
 
+  # libwayland's client API, which the app's UI calls on the display it shares with Chromium:
+  # one copy, as a wl_display works only with the library that made it.
+  wl_*;
+
 local:
   *;
 };
