Drops the global CR_XCODE_BUILD define, which upstream has only so an Xcode update recompiles
everything. Our SDK is pinned to the Command Line Tools' and the compiler is Chromium's clang, so
an Xcode update changes nothing we compile.

--- a/build/config/mac/BUILD.gn
+++ b/build/config/mac/BUILD.gn
@@ -26,11 +26,6 @@
     }
   }

-  # This is here so that all files get recompiled after an Xcode update.
-  # (defines are passed via the command line, and build system rebuild things
-  # when their commandline changes). Nothing should ever read this define.
-  defines = [ "CR_XCODE_BUILD=$xcode_build" ]
-
   asmflags = common_mac_flags
   cflags = common_mac_flags

