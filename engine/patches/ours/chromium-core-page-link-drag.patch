+// browser_core: a link dragged over a page, which the core can take from the
+// page while it's over the targets of the app's split view
+// (//browser_core/tab.cc). |point| is in the page's view, from its top-left
+// corner. Over: returns whether the core takes the drag there, where the page
+// doesn't see it. Drop: whether the core took the drop. Left: the drag left
+// the page or ended without a drop, and the return is ignored.
+enum class PageLinkDrag { kOver, kLeft, kDrop };
+using PageLinkDragHandler = bool (*)(WebContents* contents,
+                                     PageLinkDrag phase,
+                                     const DropData& data,
+                                     const gfx::PointF& point);
+CONTENT_EXPORT void SetPageLinkDragHandler(PageLinkDragHandler handler);
+// What the drag destinations ask: false while no handler is set.
+CONTENT_EXPORT bool HandlePageLinkDrag(WebContents* contents,
+                                       PageLinkDrag phase,
+                                       const DropData& data,
+                                       const gfx::PointF& point);
+
 }  // namespace content
 
