Lets the dev (component) build link libraries whose only use of Rust's prebuilt std is a function clang's runtime also has.

--- a/build/rust/std/BUILD.gn
+++ b/build/rust/std/BUILD.gn
@@ -361,6 +361,20 @@
       foreach(lib, stdlib_files) {
         this_file = "$lib_dir/lib$lib.rlib"
         ldflags += [ this_file ]
+      }
+
+      # In a component build, after the libraries' own code and clang's
+      # runtime instead, as libs. Otherwise a library without Rust code that
+      # calls a runtime function std keeps a weak copy of, as Objective-C's
+      # @available calls ___isPlatformVersionAtLeast, links std for it, and std
+      # needs the allocator only libraries with Rust code link.
+      if (is_component_build) {
+        ldflags = []
+        libs = []
+        foreach(lib, stdlib_files) {
+          libs +=
+              [ "$prebuilt_rustc_sysroot/$sysroot_lib_subdir/lib$lib.rlib" ]
+        }
       }
       visibility = [ ":*" ]
     }
