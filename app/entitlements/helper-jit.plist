<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Chromium's helper-renderer-entitlements.plist and helper-gpu-entitlements.plist, which are the
     same: V8 in the renderers and the GPU process's shader compilers write executable memory,
     which the hardened runtime otherwise refuses. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
