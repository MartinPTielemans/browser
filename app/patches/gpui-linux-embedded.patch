+
+/// Runs `f` on GPUI's display connection once it has launched embedded, unless it's in use.
+pub(crate) fn with_embedded_connection<R>(f: impl FnOnce(&DisplayConnection) -> R) -> Option<R> {
+    let platform = EMBEDDED_PLATFORM.get();
+    if platform.is_null() {
+        return None;
+    }
+    // SAFETY: as in `dispatch_embedded`.
+    let connection = unsafe { &*platform }.connection.try_borrow().ok()?;
+    Some(f(&connection))
