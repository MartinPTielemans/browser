diff --git a/crates/gpui_linux/src/linux/file_drag.rs b/crates/gpui_linux/src/linux/file_drag.rs
new file mode 100644
index 0000000000..846d17431f
--- /dev/null
+++ b/crates/gpui_linux/src/linux/file_drag.rs
@@ -0,0 +1,45 @@
+//! The system's drag of a file out of an embedder's windows, as a browser hands a download to the
+//! file manager: XDND on X11 (x11/drag.rs), the data device's drag under Wayland. It starts from
+//! the press the left button holds.
+
+use std::{cell::RefCell, path::Path};
+
+use http_client::Url;
+
+#[allow(unused_imports)]
+use super::DisplayConnection;
+
+thread_local! {
+    static ENDED: RefCell<Option<Box<dyn FnOnce(bool)>>> = const { RefCell::new(None) };
+}
+
+/// Starts the system's drag of the file at `path`, a full path, while the left button is held
+/// after going down in one of GPUI's windows. Anywhere it's let go may take a copy. `ended` runs
+/// once it's let go, with whether something took it. Returns false, and `ended` never runs, if it
+/// didn't start.
+pub fn start_file_drag(path: &Path, ended: impl FnOnce(bool) + 'static) -> bool {
+    let Ok(url) = Url::from_file_path(path) else {
+        return false;
+    };
+    let uri_list = format!("{url}\r\n");
+    let started = super::platform::with_embedded_connection(|connection| match connection {
+        #[cfg(feature = "wayland")]
+        DisplayConnection::Wayland(_) => super::wayland::start_file_drag(uri_list),
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => x11.start_file_drag(uri_list),
+        #[allow(unreachable_patterns)]
+        _ => false,
+    });
+    if started == Some(true) {
+        ENDED.set(Some(Box::new(ended)));
+        return true;
+    }
+    false
+}
+
+/// The drag `start_file_drag` started was let go, and `taken` or not.
+pub(crate) fn file_drag_ended(taken: bool) {
+    if let Some(ended) = ENDED.take() {
+        ended(taken);
+    }
+}
diff --git a/crates/gpui_linux/src/linux/overlay.rs b/crates/gpui_linux/src/linux/overlay.rs
new file mode 100644
index 0000000000..b7c1071f72
--- /dev/null
+++ b/crates/gpui_linux/src/linux/overlay.rs
@@ -0,0 +1,963 @@
+//! An embedder's overlays: windows GPUI opened with `show: false` that the embedder shows over its
+//! own window, as a browser shows its command bar over its pages. Under Wayland one is a subsurface
+//! of the embedder's surface, on X11 a window of its own over the embedder's. One shown
+//! with the keyboard gets the keys until it hides, and the embedder hears when the user leaves it:
+//! a press outside it, or the keyboard going to another window. A panel, such as a find bar, stays
+//! in its window instead (`set_overlay_panel`), and takes the keys and gives them back while it
+//! shows (`set_overlay_keyboard`). One that keeps the keys while it shows, such as a dialog, takes
+//! them back when the user left it (`take_overlay_keyboard`).
+//!
+//! The embedder asks from inside GPUI's updates, where the overlay can't draw, so what it asks of
+//! the display happens once GPUI's loop next runs, in order, as does telling it the user left.
+//! Under Wayland that waits for the embedder to have read its display
+//! (`dispatch_embedded_after_read`): Vulkan sets a surface up with a roundtrip, which would wait
+//! forever for a read the embedder has prepared and not finished.
+
+use std::{cell::RefCell, collections::VecDeque, ffi::c_void};
+
+use calloop::ping::Ping;
+use gpui::{Bounds, Pixels, Point, Size};
+#[allow(unused_imports)]
+use gpui_util::ResultExt as _;
+#[cfg(feature = "x11")]
+use x11rb::protocol::{
+    xkb,
+    xproto::{self, ConnectionExt as _},
+};
+
+#[allow(unused_imports)]
+use super::DisplayConnection;
+
+struct Shown {
+    view: usize,
+    keyboard: bool,
+    /// Shown, with the keys from now on: the key that asked for it, which reaches GPUI too, isn't
+    /// the overlay's.
+    ready: bool,
+    /// Told once the user leaves the overlay; the embedder hides it then.
+    left: Option<fn(*mut c_void)>,
+}
+
+#[allow(dead_code)]
+enum Op {
+    Show {
+        view: usize,
+        parent: usize,
+        bounds: Bounds<Pixels>,
+        radius: Pixels,
+        keyboard: bool,
+    },
+    Move {
+        view: usize,
+        bounds: Bounds<Pixels>,
+        radius: Pixels,
+    },
+    Hide {
+        view: usize,
+        keyboard: bool,
+        hidden: Box<dyn FnOnce()>,
+    },
+    Left(usize),
+    /// An overlay that shows takes the keys, or gives them back.
+    Keyboard {
+        view: usize,
+        keyboard: bool,
+    },
+    /// An overlay that has the keys takes them again: from wherever they are after a press in it
+    /// (`pressed`), or else only from the embedder's own windows, not from another app's.
+    Retake {
+        view: usize,
+        pressed: bool,
+    },
+    /// A press in a panel that shows without the keys.
+    Pressed(usize),
+    /// A window of the embedder's own shows, centred over `over` the first time (`show_window`).
+    ShowWindow {
+        view: usize,
+        over: usize,
+    },
+    HideWindow(usize),
+    /// The keyboard left the embedder's window, unless it's back by the time this runs, as a
+    /// compositor sends a leave and an enter together when the keyboard's keymap changes.
+    KeyboardLeft,
+    /// An overlay that shows takes the pointer where `set_overlay_pointer` last said.
+    Pointer(usize),
+}
+
+thread_local! {
+    static SHOWN: RefCell<Vec<Shown>> = const { RefCell::new(Vec::new()) };
+    static OPS: RefCell<VecDeque<Op>> = const { RefCell::new(VecDeque::new()) };
+    static PING: RefCell<Option<Ping>> = const { RefCell::new(None) };
+    /// On X11, the window that had the input focus before each overlay with the keyboard took it.
+    static FOCUS_FROM: RefCell<Vec<(usize, u32)>> = const { RefCell::new(Vec::new()) };
+    /// On X11, the window each overlay shows over.
+    static PARENTS: RefCell<Vec<(usize, u32)>> = const { RefCell::new(Vec::new()) };
+    /// The outlines overlays have that aren't rounded rectangles (`set_overlay_outline`).
+    static OUTLINES: RefCell<Vec<(usize, Vec<Corner>)>> = const { RefCell::new(Vec::new()) };
+    /// The menus (`set_overlay_menu`).
+    static MENUS: RefCell<Vec<usize>> = const { RefCell::new(Vec::new()) };
+    /// The panels (`set_overlay_panel`), with what a press in each runs.
+    static PANELS: RefCell<Vec<(usize, fn(*mut c_void))>> = const { RefCell::new(Vec::new()) };
+    /// Where the overlays that don't take the pointer all over take it (`set_overlay_pointer`).
+    static POINTERS: RefCell<Vec<(usize, Vec<Bounds<Pixels>>)>> = const { RefCell::new(Vec::new()) };
+    /// The overlays that show directly under another (`set_overlay_under`), by theirs and its.
+    static UNDER: RefCell<Vec<(usize, usize)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Makes the overlay `view` a panel of the window it shows over, from its next show on: on X11 a
+/// window inside that one rather than over every other, which moves with it and stays under other
+/// apps' windows, as a find bar or a toast does that stays while the user is elsewhere. Its edges
+/// aren't blended there. A press in it while it hasn't the keys runs `pressed`, after the event.
+pub fn set_overlay_panel(view: *mut c_void, pressed: fn(*mut c_void)) {
+    let view = view as usize;
+    PANELS.with_borrow_mut(|all| {
+        all.retain(|(each, _)| *each != view);
+        all.push((view, pressed));
+    });
+}
+
+/// The menu that shows, if one does.
+#[allow(dead_code)]
+pub(crate) fn shown_menu() -> Option<usize> {
+    MENUS.with_borrow(|all| all.iter().copied().find(|&view| is_shown(view)))
+}
+
+/// Whether the overlay `view` waits for its window to go where it was last asked to show.
+#[allow(dead_code)]
+pub(crate) fn placing(view: usize) -> bool {
+    OPS.with_borrow(|ops| {
+        ops.iter().any(|op| {
+            matches!(op, Op::Show { view: each, .. } | Op::Move { view: each, .. } if *each == view)
+        })
+    })
+}
+
+/// Whether `view` is a menu (`set_overlay_menu`).
+pub(crate) fn is_menu(view: usize) -> bool {
+    MENUS.with_borrow(|all| all.contains(&view))
+}
+
+/// Whether `view` is a panel that shows.
+#[allow(dead_code)]
+pub(crate) fn is_shown_panel(view: usize) -> bool {
+    is_shown(view) && is_panel(view)
+}
+
+#[allow(dead_code)]
+pub(crate) fn is_panel(view: usize) -> bool {
+    PANELS.with_borrow(|all| all.iter().any(|(each, _)| *each == view))
+}
+
+/// Gives the overlay `view` that shows the keys, or gives them back to the window that had them,
+/// as it keeps showing. `left` runs when the user next leaves it. One that has them already only
+/// waits for the user to leave again.
+pub fn set_overlay_keyboard(view: *mut c_void, keyboard: bool, left: fn(*mut c_void)) {
+    let view = view as usize;
+    let changed = SHOWN.with_borrow_mut(|all| {
+        let shown = all.iter_mut().find(|shown| shown.view == view)?;
+        shown.left = Some(left);
+        let changed = shown.keyboard != keyboard;
+        if changed {
+            shown.keyboard = keyboard;
+            shown.ready = false;
+        }
+        Some(changed)
+    });
+    if changed == Some(true) {
+        later(Op::Keyboard { view, keyboard });
+    }
+}
+
+/// Gives the overlay `view` that has the keys them again after the user left it, unless another
+/// app has them by now, as a dialog that's answered before anything else does. `left` runs when the
+/// user next leaves it.
+pub fn take_overlay_keyboard(view: *mut c_void, left: fn(*mut c_void)) {
+    let view = view as usize;
+    let keyboard = SHOWN.with_borrow_mut(|all| {
+        let shown = all.iter_mut().find(|shown| shown.view == view)?;
+        shown.left = Some(left);
+        Some(shown.keyboard)
+    });
+    if keyboard == Some(true) {
+        later(Op::Retake { view, pressed: false });
+    }
+}
+
+/// A press in GPUI's window `view`: a panel that shows without the keys hears of it, and an overlay
+/// with the keys takes them again, which on X11 it may have lost to another app.
+#[allow(dead_code)]
+pub(crate) fn pressed_in(view: usize) {
+    let keyboard = SHOWN.with_borrow(|all| {
+        all.iter().find(|shown| shown.view == view).map(|shown| shown.keyboard)
+    });
+    match keyboard {
+        Some(false) if is_panel(view) => later(Op::Pressed(view)),
+        Some(true) => later(Op::Retake { view, pressed: true }),
+        _ => {}
+    }
+}
+
+/// A corner of an overlay's outline: x and y in logical pixels from its top left, and the radius
+/// it's rounded by.
+pub type Corner = (f32, f32, f32);
+
+/// Gives the overlay `view` the outline of the polygon through `corners`, clockwise, from its next
+/// show or move on, for one that isn't a rounded rectangle, such as a popover with an arrow. What
+/// GPUI draws outside it shows on X11, which can't blend a child window with what's under it.
+pub fn set_overlay_outline(view: *mut c_void, corners: &[Corner]) {
+    let view = view as usize;
+    OUTLINES.with_borrow_mut(|all| {
+        all.retain(|(each, _)| *each != view);
+        all.push((view, corners.to_vec()));
+    });
+}
+
+/// Makes the overlay `view` take the pointer only in `areas`, in logical pixels from its top left,
+/// and let it through to what's under it elsewhere: nowhere with none, as for a HUD the mouse goes
+/// through. With no `areas` it takes it all over its outline again. From now on, if it shows.
+pub fn set_overlay_pointer(view: *mut c_void, areas: Option<&[Bounds<Pixels>]>) {
+    let view = view as usize;
+    POINTERS.with_borrow_mut(|all| {
+        all.retain(|(each, _)| *each != view);
+        if let Some(areas) = areas {
+            all.push((view, areas.to_vec()));
+        }
+    });
+    if is_shown(view) {
+        later(Op::Pointer(view));
+    }
+}
+
+thread_local! {
+    /// The embedder's window the pointer is watched over, and what hears it (`watch_pointer_over`).
+    static POINTER_OVER: std::cell::Cell<Option<(usize, fn(Point<Pixels>))>> =
+        const { std::cell::Cell::new(None) };
+}
+
+/// Hands `moved` where the pointer goes over the embedder's `parent`, in logical pixels from its
+/// top left, as it moves over the embedder's own content, which GPUI's windows don't hear; with
+/// none, stops. Only while asked, so an idle embedder isn't woken by the pointer's moves.
+pub fn watch_pointer_over(parent: *mut c_void, moved: Option<fn(Point<Pixels>)>) {
+    let parent = parent as usize;
+    let was = POINTER_OVER.replace(moved.map(|moved| (parent, moved)));
+    #[cfg(feature = "x11")]
+    super::platform::with_embedded_connection(|connection| {
+        // Under Wayland GPUI's pointer hears the embedder's surfaces anyway; on X11 its own
+        // connection asks for the moves over the embedder's window, beside the embedder's own ask.
+        if let DisplayConnection::X11(x11) = connection {
+            let x11 = x11.0.borrow();
+            if let Some((was, _)) = was.filter(|&(was, _)| moved.is_none() || was != parent) {
+                x11.watch_motion(was as _, false).log_err();
+            }
+            if moved.is_some() && was.is_none_or(|(was, _)| was != parent) {
+                x11.watch_motion(parent as _, true).log_err();
+            }
+        }
+    });
+}
+
+/// The pointer is `at` over `surface`, the embedder's or GPUI's.
+pub(crate) fn pointer_over(surface: usize, at: Point<Pixels>) {
+    if let Some((parent, moved)) = POINTER_OVER.get()
+        && parent == surface
+    {
+        moved(at);
+    }
+}
+
+/// Makes the overlay `view` show directly under the overlay `over` whenever both show, as a shadow
+/// under what casts it, or with a null `over` wherever it's put again. On X11 with no compositor,
+/// which would draw what it blends opaque, it doesn't show.
+pub fn set_overlay_under(view: *mut c_void, over: *mut c_void) {
+    let view = view as usize;
+    UNDER.with_borrow_mut(|all| {
+        all.retain(|(each, _)| *each != view);
+        if !over.is_null() {
+            all.push((view, over as usize));
+        }
+    });
+}
+
+/// The overlay `view` shows directly under, if it's one that does.
+#[allow(dead_code)]
+pub(crate) fn under(view: usize) -> Option<usize> {
+    UNDER.with_borrow(|all| all.iter().find(|(each, _)| *each == view).map(|&(_, over)| over))
+}
+
+/// The pairs of overlays that show, one under the other, that `view` is in, as each goes back
+/// over the embedder's window as it's put there.
+fn stacked_with(view: usize) -> Vec<(usize, usize)> {
+    UNDER.with_borrow(|all| {
+        (all.iter())
+            .filter(|&&(under, over)| (under == view || over == view) && is_shown(under) && is_shown(over))
+            .copied()
+            .collect()
+    })
+}
+
+/// Where the overlay `view` takes the pointer, if not all over.
+#[allow(dead_code)]
+fn pointer_areas(view: usize) -> Option<Vec<Bounds<Pixels>>> {
+    POINTERS.with_borrow(|all| {
+        let (_, areas) = all.iter().find(|(each, _)| *each == view)?;
+        Some(areas.clone())
+    })
+}
+
+/// The outline of the overlay `view` at `bounds`: its own, else its rounded rectangle.
+#[allow(dead_code)]
+fn outline(view: usize, bounds: Bounds<Pixels>, radius: Pixels) -> Vec<Corner> {
+    let own = OUTLINES.with_borrow(|all| {
+        let (_, corners) = all.iter().find(|(each, _)| *each == view)?;
+        Some(corners.clone())
+    });
+    own.unwrap_or_else(|| {
+        let (width, height) = (f32::from(bounds.size.width), f32::from(bounds.size.height));
+        let radius = f32::from(radius).min(width / 2.).min(height / 2.);
+        vec![
+            (0., 0., radius),
+            (width, 0., radius),
+            (width, height, radius),
+            (0., height, radius),
+        ]
+    })
+}
+
+/// Shows the window `view` that GPUI opened with `show: false` (its `wl_surface` or X window, as its
+/// raw handle gives it) over the embedder's `parent` (the `wl_surface` or X window GPUI's window is
+/// embedded in), at `bounds` in logical pixels from the parent's top left, its corners rounded by
+/// `radius`. It's drawn before it shows. With `keyboard` it takes the keys. `left` runs when the
+/// user leaves it, after the event. Shown already, it moves.
+pub fn show_overlay(
+    view: *mut c_void,
+    parent: *mut c_void,
+    bounds: Bounds<Pixels>,
+    radius: Pixels,
+    keyboard: bool,
+    left: fn(*mut c_void),
+) {
+    let view = view as usize;
+    if is_shown(view) {
+        later(Op::Move {
+            view,
+            bounds,
+            radius,
+        });
+        return;
+    }
+    SHOWN.with_borrow_mut(|all| {
+        all.push(Shown {
+            view,
+            keyboard,
+            ready: false,
+            left: Some(left),
+        })
+    });
+    later(Op::Show {
+        view,
+        parent: parent as usize,
+        bounds,
+        radius,
+        keyboard,
+    });
+}
+
+/// Moves and sizes the overlay `view` that shows, as `show_overlay` places it.
+pub fn move_overlay(view: *mut c_void, bounds: Bounds<Pixels>, radius: Pixels) {
+    let view = view as usize;
+    if is_shown(view) {
+        later(Op::Move {
+            view,
+            bounds,
+            radius,
+        });
+    }
+}
+
+/// Hides the overlay `view`. The window that had the keys before it has them back, after which
+/// `hidden` runs.
+pub fn hide_overlay(view: *mut c_void, hidden: impl FnOnce() + 'static) {
+    let view = view as usize;
+    let Some(shown) = SHOWN.with_borrow_mut(|all| {
+        let at = all.iter().position(|shown| shown.view == view)?;
+        Some(all.remove(at))
+    }) else {
+        return;
+    };
+    later(Op::Hide {
+        view,
+        keyboard: shown.keyboard,
+        hidden: Box::new(hidden),
+    });
+}
+
+/// Shows the window of `view`, opened with `show: false`, as a window of its own, in front and with
+/// the keys, as an app's settings window shows. On X11 it's centred over the embedder's window
+/// `over`, unless that's null; under Wayland the compositor places it.
+pub fn show_window(view: *mut c_void, over: *mut c_void) {
+    later(Op::ShowWindow {
+        view: view as usize,
+        over: over as usize,
+    });
+}
+
+/// Hides the window `show_window` showed. On X11 it keeps its place for the next show.
+pub fn hide_window(view: *mut c_void) {
+    later(Op::HideWindow(view as usize));
+}
+
+/// Makes the overlay `view` a menu, as a context menu is. On X11 its window says so, so that a
+/// compositor that runs X's clients, as sway's and Hyprland's Xwayland do, doesn't give it its own
+/// keyboard focus: one that did would take that back to the window that had it before as the menu
+/// hides, rather than leave the keys with the overlay the menu gave them back to. And it takes the
+/// pointer while a button that went down elsewhere is held over it, as when a press opened it, so
+/// that letting go on an item chooses it.
+pub fn set_overlay_menu(view: *mut c_void) {
+    MENUS.with_borrow_mut(|all| {
+        if !all.contains(&(view as usize)) {
+            all.push(view as usize);
+        }
+    });
+    super::platform::with_embedded_connection(|connection| match connection {
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => {
+            x11.0.borrow().overlay_is_menu(view as u32).log_err();
+            wake();
+        }
+        #[allow(unreachable_patterns)]
+        _ => {}
+    });
+}
+
+/// The size of the embedder's `parent`, which GPUI's window in it fills, in logical pixels.
+pub fn embedder_size(parent: *mut c_void) -> Option<Size<Pixels>> {
+    super::platform::with_embedded_connection(|connection| match connection {
+        #[cfg(feature = "wayland")]
+        DisplayConnection::Wayland(_) => super::wayland::embedded_size(parent),
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => {
+            let size = x11.0.borrow().window_size(parent as u32).log_err();
+            wake();
+            size
+        }
+        #[allow(unreachable_patterns)]
+        _ => None,
+    })
+    .flatten()
+}
+
+/// The size of the overlay `view`, as GPUI opened it or it last showed, in logical pixels.
+pub fn overlay_size(view: *mut c_void) -> Option<Size<Pixels>> {
+    super::platform::with_embedded_connection(|connection| match connection {
+        #[cfg(feature = "wayland")]
+        DisplayConnection::Wayland(_) => super::wayland::overlay_size(view),
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => {
+            let size = x11.0.borrow().window_size(view as u32).log_err();
+            wake();
+            size
+        }
+        #[allow(unreachable_patterns)]
+        _ => None,
+    })
+    .flatten()
+}
+
+/// Whether an overlay's pixels blend with what's under it, as a fade needs: under Wayland, and on
+/// X11 with a compositor, which would otherwise draw them opaque.
+pub fn overlays_blend() -> bool {
+    super::platform::with_embedded_connection(|connection| match connection {
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => x11.0.borrow().compositor_present,
+        #[allow(unreachable_patterns)]
+        _ => true,
+    })
+    .unwrap_or(true)
+}
+
+pub(crate) fn is_shown(view: usize) -> bool {
+    SHOWN.with_borrow(|all| all.iter().any(|shown| shown.view == view))
+}
+
+/// The overlay that shows with the keyboard, if one does.
+#[allow(dead_code)]
+pub(crate) fn keyboard_overlay() -> Option<usize> {
+    SHOWN.with_borrow(|all| {
+        all.iter()
+            .rev()
+            .find(|shown| shown.keyboard && shown.ready)
+            .map(|shown| shown.view)
+    })
+}
+
+/// The overlay that has the keyboard, shown or about to be. On X11 GPUI gets no key that asked for
+/// one, which went to the window it was typed in before the overlay was asked for.
+#[allow(dead_code)]
+pub(crate) fn keyboard_overlay_asked() -> Option<usize> {
+    SHOWN.with_borrow(|all| {
+        all.iter()
+            .rev()
+            .find(|shown| shown.keyboard)
+            .map(|shown| shown.view)
+    })
+}
+
+/// Holds the keys typed after the press of `shortcut`, which the embedder has now and which opens
+/// an overlay with the keyboard, for that overlay (`give_held_keys`). Under Wayland every key
+/// reaches GPUI too, and the overlay has the keyboard only once GPUI has read the keys typed by
+/// then, which it would leave to the embedder; the shortcut's press is where both find the keys
+/// to give it. Only the keystroke's key and modifiers count. With no `shortcut`, GPUI has it
+/// itself, in the press it's handling, and holds the keys after that. On X11 GPUI has none to hold.
+pub fn hold_keys(#[allow(unused_variables)] shortcut: Option<&gpui::Keystroke>) {
+    #[cfg(feature = "wayland")]
+    super::wayland::hold_keys(shortcut);
+}
+
+/// The overlay `view` takes the keys held since a shortcut (`hold_keys`), and gets them once it
+/// shows with the keyboard, before those typed later. Says whether GPUI holds them; if it doesn't,
+/// as on X11, the embedder gives the overlay those it held.
+pub fn give_held_keys(#[allow(unused_variables)] view: *mut c_void) -> bool {
+    #[cfg(feature = "wayland")]
+    return super::wayland::give_held_keys(view as usize);
+    #[cfg(not(feature = "wayland"))]
+    false
+}
+
+/// The user left the overlay `view`, as when the embedder dismisses it.
+pub fn leave_overlay(view: *mut c_void) {
+    left(view as usize);
+}
+
+/// The user left the overlay `view`.
+pub(crate) fn left(view: usize) {
+    if is_shown(view) {
+        later(Op::Left(view));
+    }
+}
+
+/// A press outside each overlay that shows but `on`, the window pressed, if it's GPUI's.
+#[allow(dead_code)]
+pub(crate) fn pressed(on: Option<usize>) {
+    let views: Vec<usize> = SHOWN.with_borrow(|all| {
+        all.iter()
+            .map(|shown| shown.view)
+            .filter(|&view| Some(view) != on)
+            .collect()
+    });
+    views.into_iter().for_each(left);
+}
+
+/// The keyboard went to another window, away from each overlay.
+#[allow(dead_code)]
+pub(crate) fn left_all() {
+    if SHOWN.with_borrow(|all| !all.is_empty()) {
+        later(Op::KeyboardLeft);
+    }
+}
+
+fn later(op: Op) {
+    OPS.with_borrow_mut(|ops| ops.push_back(op));
+    wake();
+}
+
+/// Has GPUI's loop run what the embedder asked. On X11 it then handles the events that the
+/// embedder's wait for a reply read into xcb's queue, where they don't wake it
+/// (`dispatch_embedded`).
+fn wake() {
+    PING.with_borrow_mut(|ping| {
+        if ping.is_none() {
+            *ping = make_ping();
+        }
+        if let Some(ping) = ping {
+            ping.ping();
+        }
+    });
+}
+
+fn make_ping() -> Option<Ping> {
+    let handle = super::platform::embedded_loop_handle()?;
+    let (ping, source) = calloop::ping::make_ping().log_err()?;
+    handle
+        .insert_source(source, |_, _, _| run_when_free())
+        .ok()?;
+    Some(ping)
+}
+
+fn run_when_free() {
+    let wayland = super::platform::with_embedded_connection(|connection| {
+        #[cfg(feature = "wayland")]
+        if let DisplayConnection::Wayland(_) = connection {
+            return true;
+        }
+        false
+    });
+    #[cfg(feature = "wayland")]
+    if wayland == Some(true) {
+        // After the events read with it, such as the key that asked for an overlay (`ready`).
+        if !super::platform::embedder_has_read() {
+            // The compositor's answer has the embedder read, and then dispatch GPUI.
+            super::wayland::wake_after_read();
+        }
+        return;
+    }
+    run();
+}
+
+thread_local! {
+    /// What runs once Control is up, while the embedder watches it (`watch_control`).
+    static CONTROL_RELEASED: RefCell<Option<Box<dyn FnOnce()>>> = const { RefCell::new(None) };
+}
+
+/// Calls `released` once, after the event that shows Control is no longer held, or at once if it
+/// isn't. On X11 that's Control going up anywhere on the display, as XKB tells every client its
+/// keyboard's state; under Wayland, Control going up in the embedder's surfaces, whose keys GPUI's
+/// keyboard hears too, or the keyboard leaving them. A later call replaces `released`.
+pub fn watch_control(released: impl FnOnce() + 'static) {
+    CONTROL_RELEASED.set(Some(Box::new(released)));
+    let held = super::platform::with_embedded_connection(|connection| match connection {
+        #[cfg(feature = "wayland")]
+        DisplayConnection::Wayland(_) => super::wayland::control_held(),
+        // The server's, as GPUI may not have heard yet of a press the embedder's connection has.
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => {
+            use x11rb::protocol::xkb::ConnectionExt as _;
+            let xcb = x11.0.borrow().xcb_connection.clone();
+            let state = xcb.xkb_get_state(xkb::ID::USE_CORE_KBD.into());
+            let state = state.ok().and_then(|state| state.reply().log_err());
+            state.is_some_and(|state| state.mods.contains(xproto::ModMask::CONTROL))
+        }
+        #[allow(unreachable_patterns)]
+        _ => false,
+    });
+    control_changed(held == Some(true));
+}
+
+/// Control is `held`, or not, after a change to the keyboard's state.
+pub(crate) fn control_changed(held: bool) {
+    if !held && let Some(released) = CONTROL_RELEASED.take() {
+        released();
+    }
+}
+
+thread_local! {
+    /// What runs each time Alt is pressed and let go alone (`watch_alt_taps`).
+    static ALT_TAPPED: RefCell<Option<Box<dyn Fn()>>> = const { RefCell::new(None) };
+    /// Alt went down with no other modifier held, and no key or press has come since.
+    static ALT_ALONE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Calls `tapped` each time Alt is pressed and let go with nothing between, while no overlay has
+/// the keyboard. Another key or modifier, a press or a scroll makes it part of something else: a
+/// shortcut, a typed character or an Alt-click. On X11 GPUI hears the keys of its own windows
+/// alone; under Wayland every key of the embedder's too.
+pub fn watch_alt_taps(tapped: impl Fn() + 'static) {
+    ALT_TAPPED.set(Some(Box::new(tapped)));
+}
+
+/// A key went down or up (`pressed`): Alt, or another, with or without other modifiers held
+/// before it.
+pub(crate) fn key_changed(alt: bool, pressed: bool, modifiers_held: bool) {
+    match (alt, pressed) {
+        (true, true) => ALT_ALONE.set(!modifiers_held),
+        (true, false) => {
+            if ALT_ALONE.take() && keyboard_overlay().is_none() {
+                ALT_TAPPED.with_borrow(|tapped| tapped.as_ref().map(|tapped| tapped()));
+            }
+        }
+        (false, true) => ALT_ALONE.set(false),
+        // A key let go that went down before Alt did.
+        (false, false) => {}
+    }
+}
+
+/// A button was pressed, the wheel's too, or the keyboard went elsewhere.
+pub(crate) fn alt_interrupted() {
+    ALT_ALONE.set(false);
+}
+
+/// Runs what the embedder asked, once it has read its Wayland display.
+pub(crate) fn run_after_read() {
+    if OPS.with_borrow(|ops| !ops.is_empty()) {
+        run();
+    }
+}
+
+fn run() {
+    #[allow(unused_variables, unused_mut)]
+    let mut applied = false;
+    while let Some(op) = OPS.with_borrow_mut(|ops| ops.pop_front()) {
+        applied |= run_op(op);
+    }
+    // The events the display sends for what the ops asked, such as an overlay's new size.
+    if applied {
+        sync_display();
+    }
+}
+
+/// Has GPUI handle the events the X server sent it before now, such as a test driver's. A wait for
+/// a reply, here or on another thread of the connection's, can read them into xcb's queue, where
+/// they don't wake the loop: they're all read by the reply to one more request, and handled now.
+pub fn sync_display() {
+    #[cfg(feature = "x11")]
+    {
+        let x11 = super::platform::with_embedded_connection(|connection| match connection {
+            DisplayConnection::X11(x11) => Some(super::X11Client::clone(x11)),
+            #[allow(unreachable_patterns)]
+            _ => None,
+        });
+        if let Some(x11) = x11.flatten() {
+            let xcb = x11.0.borrow().xcb_connection.clone();
+            let synced = xcb.get_input_focus().map(|focus| focus.reply());
+            if let Some(Ok(_)) = synced.log_err() {
+                x11.process_x11_events(&xcb).log_err();
+            }
+        }
+    }
+}
+
+/// Runs `op`, and says whether it asked the display for anything.
+fn run_op(op: Op) -> bool {
+    match op {
+        #[cfg(feature = "wayland")]
+        Op::KeyboardLeft if super::wayland::keyboard_entered() => false,
+        Op::KeyboardLeft => {
+            pressed(None);
+            false
+        }
+        Op::Left(view) => {
+            let left = SHOWN.with_borrow_mut(|all| {
+                let shown = all.iter_mut().find(|shown| shown.view == view)?;
+                shown.left.take()
+            });
+            if let Some(left) = left {
+                left(view as *mut c_void);
+            }
+            false
+        }
+        Op::Pressed(view) => {
+            let pressed = PANELS.with_borrow(|all| {
+                all.iter().find(|(each, _)| *each == view).map(|&(_, pressed)| pressed)
+            });
+            if let Some(pressed) = pressed.filter(|_| is_shown(view)) {
+                pressed(view as *mut c_void);
+            }
+            false
+        }
+        Op::Hide {
+            view,
+            keyboard,
+            hidden,
+        } => {
+            let op = Op::Hide {
+                view,
+                keyboard,
+                hidden: Box::new(|| {}),
+            };
+            super::platform::with_embedded_connection(|connection| apply(op, connection));
+            hidden();
+            true
+        }
+        op => {
+            let shown = match op {
+                Op::Show { view, .. } | Op::Keyboard { view, .. } => Some(view),
+                _ => None,
+            };
+            let placed = match op {
+                Op::Show { view, .. } | Op::Move { view, .. } => Some(view),
+                _ => None,
+            };
+            super::platform::with_embedded_connection(|connection| apply(op, connection));
+            // Put back over the embedder's window, it may have gone over one that shows under it.
+            for (under, over) in placed.map(stacked_with).unwrap_or_default() {
+                super::platform::with_embedded_connection(|connection| {
+                    place_under(under, over, connection)
+                });
+            }
+            if let Some(view) = shown {
+                SHOWN.with_borrow_mut(|all| {
+                    all.iter_mut()
+                        .filter(|each| each.view == view)
+                        .for_each(|each| each.ready = true)
+                });
+                // The keys typed since the shortcut that showed it, before those typed later.
+                #[cfg(feature = "wayland")]
+                super::wayland::deliver_held_keys();
+            }
+            true
+        }
+    }
+}
+
+/// Keeps `from`, which had the input focus before the overlay `view` took it, to give it back to,
+/// unless the overlay took it before and keeps the window it had it from first.
+#[cfg(feature = "x11")]
+fn focus_from(view: usize, from: u32) {
+    FOCUS_FROM.with_borrow_mut(|all| {
+        if from != x11rb::NONE && !all.iter().any(|&(each, _)| each == view) {
+            all.push((view, from));
+        }
+    });
+}
+
+/// The overlay but `view` that takes the keys in an op still to run.
+#[cfg(feature = "x11")]
+fn next_to_take_keys(view: usize) -> Option<usize> {
+    OPS.with_borrow(|ops| {
+        ops.iter().find_map(|op| match op {
+            Op::Show { view: next, keyboard: true, .. }
+            | Op::Keyboard { view: next, keyboard: true }
+                if *next != view =>
+            {
+                Some(*next)
+            }
+            _ => None,
+        })
+    })
+}
+
+/// Stacks the overlay `under` directly under the overlay `over`, both showing.
+#[allow(unused_variables)]
+fn place_under(under: usize, over: usize, connection: &DisplayConnection) {
+    match connection {
+        #[cfg(feature = "wayland")]
+        DisplayConnection::Wayland(_) => super::wayland::place_overlay_under(under as _, over as _),
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => {
+            x11.0.borrow().place_overlay_under(under as _, over as _).log_err();
+        }
+        #[allow(unreachable_patterns)]
+        _ => {}
+    }
+}
+
+#[allow(unused_variables)]
+fn apply(op: Op, connection: &DisplayConnection) {
+    match connection {
+        #[cfg(feature = "wayland")]
+        DisplayConnection::Wayland(_) => match op {
+            Op::Show {
+                view,
+                parent,
+                bounds,
+                keyboard,
+                ..
+            } => {
+                super::wayland::show_overlay(view as _, parent as _, bounds, keyboard).log_err();
+                super::wayland::overlay_pointer(view as _, pointer_areas(view).as_deref());
+            }
+            Op::Pointer(view) => {
+                super::wayland::overlay_pointer(view as _, pointer_areas(view).as_deref())
+            }
+            Op::Move { view, bounds, .. } => super::wayland::move_overlay(view as _, bounds),
+            Op::Hide { view, keyboard, .. } => super::wayland::hide_overlay(view as _, keyboard),
+            Op::Keyboard { view, keyboard } => super::wayland::overlay_keyboard(view as _, keyboard),
+            // The compositor gives the embedder's surface the keys back, and they come here then.
+            Op::Retake { view, pressed: false } => super::wayland::overlay_keyboard(view as _, true),
+            Op::Retake { pressed: true, .. } => {}
+            Op::ShowWindow { view, .. } => {
+                super::wayland::show_window(view as _).log_err();
+            }
+            Op::HideWindow(view) => super::wayland::hide_window(view as _),
+            Op::Left(_) | Op::Pressed(_) | Op::KeyboardLeft => {}
+        },
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => {
+            let x11 = x11.0.borrow();
+            match op {
+                Op::Show {
+                    view,
+                    parent,
+                    bounds,
+                    radius,
+                    keyboard,
+                } => {
+                    let outline = outline(view, bounds, radius);
+                    PARENTS.with_borrow_mut(|all| {
+                        all.retain(|&(each, _)| each != view);
+                        all.push((view, parent as u32));
+                    });
+                    let panel = is_panel(view);
+                    // Before it maps: mapped under the pointer with no input shape yet, it would
+                    // take the pointer from the window under it, whose hover, and tooltip, then go.
+                    x11.overlay_pointer(view as _, pointer_areas(view).as_deref()).log_err();
+                    let from =
+                        x11.show_overlay(view as _, parent as _, bounds, &outline, keyboard, panel);
+                    if let Some(from) = from.log_err() {
+                        focus_from(view, from);
+                    }
+                }
+                Op::Pointer(view) => {
+                    x11.overlay_pointer(view as _, pointer_areas(view).as_deref()).log_err();
+                }
+                Op::Move {
+                    view,
+                    bounds,
+                    radius,
+                } => {
+                    let outline = outline(view, bounds, radius);
+                    let parent = PARENTS.with_borrow(|all| {
+                        all.iter().find(|&&(each, _)| each == view).map(|&(_, parent)| parent)
+                    });
+                    if let Some(parent) = parent {
+                        let panel = is_panel(view);
+                        x11.move_overlay(view as _, parent, bounds, &outline, panel).log_err();
+                    }
+                }
+                Op::Hide { view, .. } => {
+                    let from = FOCUS_FROM.with_borrow_mut(|all| {
+                        let at = all.iter().position(|&(each, _)| each == view)?;
+                        Some(all.remove(at).1)
+                    });
+                    let from = from.unwrap_or(0);
+                    // The overlay that takes the keys next, such as the command bar a menu's item
+                    // opens, takes them from this one, to give back where this one had them from.
+                    // Given back in between, wlroots 0.17's Xwayland would put the input focus on
+                    // that window's top-level once the next overlay had it, as it does each time
+                    // the focus comes into a top-level, and the next one would close.
+                    if from != x11rb::NONE
+                        && let Some(next) = next_to_take_keys(view)
+                    {
+                        focus_from(next, from);
+                        x11.hide_overlay(view as _, x11rb::NONE).log_err();
+                        return;
+                    }
+                    // The user left the overlay that had the keys before, such as a find bar under
+                    // the command bar, which would wait for them back.
+                    if x11.hide_overlay(view as _, from).log_err() == Some(true) {
+                        left(from as usize);
+                    }
+                }
+                Op::Keyboard { view, keyboard: true } => {
+                    if let Some(from) = x11.overlay_takes_focus(view as _, None).log_err() {
+                        focus_from(view, from);
+                    }
+                }
+                Op::Retake { view, pressed } => {
+                    let parent = PARENTS.with_borrow(|all| {
+                        all.iter().find(|&&(each, _)| each == view).map(|&(_, parent)| parent)
+                    });
+                    let within = parent.filter(|_| !pressed);
+                    if let Some(from) = x11.overlay_takes_focus(view as _, within).log_err() {
+                        focus_from(view, from);
+                    }
+                }
+                Op::Keyboard { view, keyboard: false } => {
+                    let from = FOCUS_FROM.with_borrow_mut(|all| {
+                        let at = all.iter().position(|&(each, _)| each == view)?;
+                        Some(all.remove(at).1)
+                    });
+                    x11.overlay_gives_focus(view as _, from.unwrap_or(0)).log_err();
+                }
+                Op::ShowWindow { view, over } => {
+                    x11.show_window(view as _, over as _).log_err();
+                }
+                Op::HideWindow(view) => {
+                    x11.hide_window(view as _).log_err();
+                }
+                Op::Left(_) | Op::Pressed(_) | Op::KeyboardLeft => {}
+            }
+        }
+        #[allow(unreachable_patterns)]
+        _ => {}
+    }
+}
