+            zwp_pointer_gesture_swipe_v1::Event::End { cancelled, .. } => {
+                let Some(swipe) = state.swipe.take() else {
+                    return;
+                };
+                // Three, as macOS's swipe between pages takes by default; two fingers scroll.
+                let sideways = swipe.x.abs() >= EMBEDDER_SWIPE_DISTANCE
+                    && swipe.x.abs() > 2. * swipe.y.abs();
+                if cancelled != 0 || swipe.fingers != 3 || !sideways {
