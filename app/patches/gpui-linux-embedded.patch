+            (rows.iter().filter(|row| row.y == y))
+                .map(|row| (row.x, row.width))
+                .collect()
+        };
+        // A rounded rectangle: its top row inset by its corners, its middle the full width.
+        let card = [
+            (0., 0., 10.),
+            (100., 0., 10.),
+            (100., 40., 10.),
+            (0., 40., 10.),
+        ];
+        let rows = outline_rows(&card, 40, true);
+        assert_eq!(span(&rows, 20), [(0, 100)]);
+        let (top, bottom) = (span(&rows, 0), span(&rows, 39));
+        assert_eq!(top, bottom);
+        assert!(top[0].0 >= 3 && top[0].0 <= 7 && top[0].1 == 100 - 2 * top[0].0 as u16);
+        // A card with an arrow on top: the arrow's rows are narrow, under it the card's are whole.
+        let popover = [
+            (50., 0., 0.),
+            (60., 10., 0.),
+            (100., 10., 0.),
+            (100., 50., 0.),
+            (0., 50., 0.),
+            (0., 10., 0.),
+            (40., 10., 0.),
+        ];
+        let rows = outline_rows(&popover, 50, true);
+        assert_eq!(span(&rows, 4), [(45, 10)]);
+        // Without a compositor, only the pixels the arrow covers half of.
+        let rows = outline_rows(&popover, 50, false);
+        assert_eq!(span(&rows, 4), [(46, 9)]);
+        assert_eq!(span(&rows, 30), [(0, 100)]);
+    }
