+
+/// Opens the next window inside `host_window`, an X11 window of an embedder's such as a browser
+/// engine's, instead of as a window of its own. It fills the host as it opens; the embedder sizes
+/// it from then on, and the options that describe a top-level window don't apply.
+pub fn open_next_window_in(host_window: u32) {
+    NEXT_HOST_WINDOW.set(host_window);
+}
+
+/// GPUI's window `x_window`, once it has launched embedded.
+fn embedded_window(x_window: u32) -> Option<X11WindowStatePtr> {
+    crate::linux::platform::with_embedded_connection(|connection| match connection {
+        crate::linux::DisplayConnection::X11(x11) => x11.get_window(x_window),
+        #[allow(unreachable_patterns)]
+        _ => None,
+    })
+    .flatten()
+}
+
+static POINTER_DRIVEN: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// For a test driver, which moves the pointer with core events sent to GPUI's windows: from now on
+/// GPUI leaves out the X server's own pointer's crossings, which nothing moves, so it sends them
+/// only as windows change around it, where the driver's pointer isn't.
+pub fn drive_pointer() {
+    POINTER_DRIVEN.store(true, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn pointer_driven() -> bool {
+    POINTER_DRIVEN.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// For a test driver, as an input method: the text field with the keys in GPUI's window
+/// `x_window` composes `text` with `selected` selected in it, or stops composing with `text`
+/// empty. Returns false unless `x_window` is GPUI's and takes text.
+pub fn drive_compose(x_window: u32, text: &str, selected: Option<std::ops::Range<usize>>) -> bool {
+    embedded_window(x_window)
+        .map(|window| {
+            window.with_input_handler(|handler| match text.is_empty() {
+                true => {
+                    if let Some(marked) = handler.marked_text_range() {
+                        handler.replace_text_in_range(Some(marked), "");
+                    }
+                }
+                false => handler.replace_and_mark_text_in_range(None, text, selected),
+            })
+        })
+        .is_some()
+}
+
+/// As `drive_compose`: commits `text` in place of what was composed.
+pub fn drive_commit(x_window: u32, text: &str) -> bool {
+    embedded_window(x_window)
+        .map(|window| window.with_input_handler(|handler| handler.replace_text_in_range(None, text)))
+        .is_some()
+}
+
