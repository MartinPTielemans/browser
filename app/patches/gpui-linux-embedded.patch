+            x11rb::COPY_DEPTH_FROM_PARENT,
+            window,
+            parent,
+            0,
+            0,
+            1,
+            1,
+            0,
+            xproto::WindowClass::INPUT_OUTPUT,
+            x11rb::COPY_FROM_PARENT,
+            &xproto::CreateWindowAux::new(),
