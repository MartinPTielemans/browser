+    /// Makes the overlay `view` take the pointer only in `areas`, in logical pixels from its top
+    /// left, and let it through elsewhere, or take it all over its shape.
+    pub(crate) fn overlay_pointer(
+        &self,
+        view: xproto::Window,
+        areas: Option<&[Bounds<Pixels>]>,
+    ) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        match areas {
+            Some(areas) => {
+                let scale = self.scale_factor;
+                let rectangles: Vec<_> = (areas.iter())
+                    .map(|area| {
+                        let at = |pixels: Pixels| (f32::from(pixels) * scale).round();
+                        xproto::Rectangle {
+                            x: at(area.origin.x) as i16,
+                            y: at(area.origin.y) as i16,
+                            width: at(area.size.width) as u16,
+                            height: at(area.size.height) as u16,
+                        }
+                    })
+                    .collect();
+                xcb.shape_rectangles(
+                    shape::SO::SET,
+                    shape::SK::INPUT,
+                    xproto::ClipOrdering::UNSORTED,
+                    view,
+                    0,
+                    0,
