+/// A calloop timer, or when embedded, a timerfd that does the same: an embedder that dispatches
+/// GPUI's loop when [`embedded_fd`] is readable never sees calloop's own timers come due.
+pub(crate) fn insert_timer(
+    handle: &LoopHandle<'static, ()>,
+    after: Duration,
+    mut callback: impl FnMut(Instant) -> calloop::timer::TimeoutAction + 'static,
+) -> Result<calloop::RegistrationToken, calloop::Error> {
+    use calloop::timer::TimeoutAction;
+    use std::os::fd::{AsRawFd as _, FromRawFd as _, OwnedFd};
+    if !is_embedded() {
+        return handle
+            .insert_source(
+                calloop::timer::Timer::from_duration(after),
+                move |deadline, _, _| callback(deadline),
+            )
+            .map_err(|error| error.error);
+    }
+    fn arm(fd: &OwnedFd, after: Duration) {
+        // A zero time disarms a timerfd, so one due now fires after a nanosecond.
+        let after = after.max(Duration::from_nanos(1));
+        let spec = libc::itimerspec {
+            it_interval: libc::timespec {
+                tv_sec: 0,
+                tv_nsec: 0,
+            },
+            it_value: libc::timespec {
+                tv_sec: after.as_secs() as _,
+                tv_nsec: after.subsec_nanos() as _,
+            },
+        };
+        // SAFETY: a plain system call on a timerfd this owns.
+        unsafe { libc::timerfd_settime(fd.as_raw_fd(), 0, &spec, std::ptr::null_mut()) };
+    }
+    // SAFETY: as above.
+    let fd = unsafe {
+        let fd = libc::timerfd_create(
+            libc::CLOCK_MONOTONIC,
+            libc::TFD_NONBLOCK | libc::TFD_CLOEXEC,
+        );
+        if fd < 0 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+        OwnedFd::from_raw_fd(fd)
+    };
+    arm(&fd, after);
+    let mut deadline = Instant::now() + after;
+    handle
+        .insert_source(
+            calloop::generic::Generic::new(fd, calloop::Interest::READ, calloop::Mode::Level),
+            move |_, fd, _| {
+                let mut expirations = 0u64;
+                // SAFETY: reads the expiration count into a u64, as a timerfd wants.
+                unsafe { libc::read(fd.as_raw_fd(), (&raw mut expirations).cast(), 8) };
+                let next = match callback(deadline) {
+                    TimeoutAction::Drop => return Ok(calloop::PostAction::Remove),
+                    TimeoutAction::ToDuration(after) => Instant::now() + after,
+                    TimeoutAction::ToInstant(instant) => instant,
+                };
+                deadline = next;
+                arm(fd, next.saturating_duration_since(Instant::now()));
+                Ok(calloop::PostAction::Continue)
+            },
+        )
+        .map_err(|error| error.error)
+}
