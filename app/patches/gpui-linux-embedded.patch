+
+/// Whether the keys `window` has are the embedder's now: the embedder's pages take them, not GPUI.
+fn keys_are_embedders(window: &WaylandWindowStatePtr) -> bool {
+    match (
+        window.embedded_parent(),
+        crate::linux::platform::embedded_keyboard(),
+    ) {
+        (Some(parent), Some(keyboard)) => !(keyboard.is_ui)(parent),
+        _ => false,
+    }
