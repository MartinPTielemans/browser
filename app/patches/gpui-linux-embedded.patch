+        // that sends Shift + "]" very rapidly. The modifier state notification
+        // for Shift hasn't reached us yet, so the server state has no
+        // modifiers. But the key event itself carries the correct Shift state.
+        assert_eq!(server_state.serialize_mods(xkbc::STATE_MODS_EFFECTIVE), 0);
+        let key_event_state = xkb_state_for_key_event(&server_state, xproto::KeyButMask::SHIFT);
+
+        // Assert Shift+"]" produces "}" even when the Shift notification
+        // arrived late.
+        assert_eq!(key_event_state.key_get_utf8(bracket), "}");
+    }
+
+    // https://github.com/zed-industries/zed/issues/49329
+    #[test]
+    fn sequential_key_events_do_not_corrupt_state() {
+        let keymap = test_keymap("us");
+        let server_state = xkbc::State::new(&keymap);
+
+        // Simulate typing "a s d" with spaces in between, all without any
+        // modifier keys held.
+        let keys: &[(&str, &str)] = &[
+            ("AC01", "a"),
+            ("SPCE", " "),
+            ("AC02", "s"),
+            ("SPCE", " "),
+            ("AC03", "d"),
+        ];
+
+        for &(key_name, expected_utf8) in keys {
+            let keycode = keymap
+                .key_by_name(key_name)
+                .expect("test key should exist in the keymap");
+
+            let key_event_state =
+                xkb_state_for_key_event(&server_state, xproto::KeyButMask::default());
+
+            // Assert each key in the sequence produces the expected character
+            // (no dropped or garbled input from state corruption).
+            assert_eq!(
+                key_event_state.key_get_utf8(keycode),
+                expected_utf8,
+                "key {key_name} should produce {expected_utf8:?}",
+            );
+        }
+
+        // Assert the server state is completely untouched after processing
+        // all key events.
+        assert_eq!(server_state.serialize_mods(xkbc::STATE_MODS_EFFECTIVE), 0);
+        assert_eq!(server_state.serialize_layout(STATE_LAYOUT_EFFECTIVE), 0);
+    }
+
+    // https://github.com/zed-industries/zed/issues/26468
+    #[test]
+    fn space_works_with_czech_layout_active() {
+        // US + Czech dual-layout keyboard.
+        let keymap = test_keymap("us,cz");
+        let mut server_state = xkbc::State::new(&keymap);
+        let space = keymap
+            .key_by_name("SPCE")
+            .expect("space key should exist in the keymap");
+
+        // Simulate the user having switched to the Czech layout.
+        server_state.update_mask(0, 0, 0, 0, 0, 1);
+
+        let key_event_state = xkb_state_for_key_event(&server_state, xproto::KeyButMask::default());
+
+        // Assert pressing space while on the Czech layout still types a space.
+        assert_eq!(key_event_state.key_get_utf8(space), " ");
+    }
+}
+
+/// The rows of the polygon through `corners`, each x, y and the radius it's rounded by, in device
+/// pixels, for a shape `height` rows tall: each row's spans through the middle of its pixels, or,
+/// `touching`, with every pixel the polygon touches, so that the edges GPUI smooths are inside it.
+fn outline_rows(corners: &[(f32, f32, f32)], height: i16, touching: bool) -> Vec<xproto::Rectangle> {
+    let points = rounded_polygon(corners);
+    let spans = |y: f32| {
+        let mut crossings: Vec<f32> = (points.iter())
+            .zip(points.iter().cycle().skip(1))
+            .filter(|(a, b)| (a.1 <= y) != (b.1 <= y))
+            .map(|(a, b)| a.0 + (y - a.1) / (b.1 - a.1) * (b.0 - a.0))
+            .collect();
+        crossings.sort_by(f32::total_cmp);
+        crossings
+    };
+    let mut rows = Vec::new();
+    for row in 0..height {
+        // Across the row, top to bottom; its middle's alone where the spans come apart in it.
+        let samples = [0.01, 0.5, 0.99].map(|at| spans(row as f32 + at));
+        let middle = &samples[1];
+        let whole = touching && samples.iter().all(|each| each.len() == middle.len());
+        let crossings: Vec<f32> = match whole {
+            true => (0..middle.len())
+                .map(|index| {
+                    let all = samples.iter().map(|each| each[index]);
+                    match index % 2 {
+                        0 => all.fold(f32::MAX, f32::min).floor(),
+                        _ => all.fold(f32::MIN, f32::max).ceil(),
+                    }
+                })
+                .collect(),
+            false => middle.iter().map(|x| x.round()).collect(),
+        };
+        for span in crossings.chunks_exact(2) {
+            let (left, right) = (span[0] as i16, span[1] as i16);
+            if right > left {
+                rows.push(xproto::Rectangle {
+                    x: left,
+                    y: row,
+                    width: (right - left) as u16,
+                    height: 1,
+                });
+            }
+        }
+    }
+    rows
+}
+
+/// The polygon through `corners` with each rounded by its radius, its arcs in short lines.
+fn rounded_polygon(corners: &[(f32, f32, f32)]) -> Vec<(f32, f32)> {
+    let count = corners.len();
+    let at = |index: usize| (corners[index % count].0, corners[index % count].1);
+    let mut points = Vec::new();
+    for index in 0..count {
+        let here = at(index);
+        let radius = corners[index].2;
+        let unit = |to: (f32, f32)| {
+            let (dx, dy) = (to.0 - here.0, to.1 - here.1);
+            let length = dx.hypot(dy).max(f32::EPSILON);
+            (dx / length, dy / length)
+        };
+        let (before, after) = (unit(at(index + count - 1)), unit(at(index + 1)));
+        // The arc meets each side as far along it as the radius over the tangent of half the angle
+        // between them, and its centre is on the line halving that angle.
+        let half = (before.0 * after.0 + before.1 * after.1)
+            .clamp(-1., 1.)
+            .acos()
+            / 2.;
+        let (bx, by) = (before.0 + after.0, before.1 + after.1);
+        let bisector = bx.hypot(by);
+        if radius <= 0. || bisector < 1e-4 {
+            points.push(here);
+            continue;
+        }
+        let along = radius / half.tan();
+        let distance = radius / half.sin();
+        let centre = (
+            here.0 + bx / bisector * distance,
+            here.1 + by / bisector * distance,
+        );
+        let angle = |point: (f32, f32)| (point.1 - centre.1).atan2(point.0 - centre.0);
+        let start = angle((here.0 + before.0 * along, here.1 + before.1 * along));
+        let end = angle((here.0 + after.0 * along, here.1 + after.1 * along));
+        let mut sweep = end - start;
+        if sweep > std::f32::consts::PI {
+            sweep -= std::f32::consts::TAU;
+        } else if sweep < -std::f32::consts::PI {
+            sweep += std::f32::consts::TAU;
+        }
+        // Within about a tenth of a pixel of the arc.
+        let steps = (radius.sqrt() * 2.).ceil().max(2.) as usize;
+        for step in 0..=steps {
+            let a = start + sweep * step as f32 / steps as f32;
+            points.push((centre.0 + radius * a.cos(), centre.1 + radius * a.sin()));
+        }
+    }
+    points
+}
diff --git a/crates/gpui_linux/src/linux/x11/drag.rs b/crates/gpui_linux/src/linux/x11/drag.rs
new file mode 100644
index 0000000000..84f66f7604
--- /dev/null
+++ b/crates/gpui_linux/src/linux/x11/drag.rs
@@ -0,0 +1,310 @@
+//! A file's drag out of GPUI's windows on X11, as XDND's source (freedesktop.org's XDND, version
+//! 5): the window the left button went down in owns `XdndSelection`, the pointer is grabbed until
+//! it's let go, and the top-level window under it that takes XDND hears where it is and, if it
+//! accepts the file there, gets it. GPUI is XDND's target in client.rs.
+
+use gpui_util::ResultExt as _;
+use x11rb::{
+    connection::Connection as _,
+    protocol::xproto::{
+        self, AtomEnum, ClientMessageEvent, ConnectionExt as _, EventMask, GrabMode, PropMode,
+        SelectionNotifyEvent, SelectionRequestEvent,
+    },
+    xcb_ffi::XCBConnection,
+};
+
+use super::{X11Client, XcbAtoms};
+
+pub(crate) struct FileDrag {
+    /// GPUI's window it started in, which owns `XdndSelection` and hears from the targets.
+    window: xproto::Window,
+    uri_list: Vec<u8>,
+    /// Until it's let go.
+    held: bool,
+    /// The top-level window under the pointer that takes XDND, with its version.
+    target: Option<(xproto::Window, u32)>,
+    /// The target was told where the pointer is and hasn't answered, as XDND has the source wait
+    /// for before it says again.
+    asked: bool,
+    /// Where the pointer moved to on the root while the target hadn't answered, and when.
+    moved: Option<(i16, i16, u32)>,
+    accepted: bool,
+    /// Let go while the target hadn't answered, when.
+    released: Option<u32>,
+}
+
+impl X11Client {
+    /// Starts dragging `uri_list`, a `text/uri-list`, from the window the left button went down in,
+    /// which it's held in.
+    pub(crate) fn start_file_drag(&self, uri_list: String) -> bool {
+        let mut state = self.0.borrow_mut();
+        let Some(window) = state.pressed_window.filter(|_| state.file_drag.is_none()) else {
+            return false;
+        };
+        let xcb = state.xcb_connection.clone();
+        let root = xcb.setup().roots[state.x_root_index].root;
+        let owned = xcb.set_selection_owner(window, state.atoms.XdndSelection, x11rb::CURRENT_TIME);
+        if owned.log_err().is_none() {
+            return false;
+        }
+        // On the root, which a hold on the window the press went down in would lose as that window
+        // hides, as the downloads' window does when one of its files is dragged.
+        xcb.grab_pointer(
+            false,
+            root,
+            EventMask::POINTER_MOTION | EventMask::BUTTON_RELEASE,
+            GrabMode::ASYNC,
+            GrabMode::ASYNC,
+            x11rb::NONE,
+            x11rb::NONE,
+            x11rb::CURRENT_TIME,
+        )
+        .log_err();
+        xcb.flush().log_err();
+        state.file_drag = Some(FileDrag {
+            window,
+            uri_list: uri_list.into_bytes(),
+            held: true,
+            target: None,
+            asked: false,
+            moved: None,
+            accepted: false,
+            released: None,
+        });
+        true
+    }
+
+    pub(crate) fn file_drag_held(&self) -> bool {
+        (self.0.borrow().file_drag.as_ref()).is_some_and(|drag| drag.held)
+    }
+
+    /// The pointer moved to (x, y) on the root at `time`.
+    pub(crate) fn file_drag_moved(&self, x: i16, y: i16, time: u32) {
+        let mut state = self.0.borrow_mut();
+        let state = &mut *state;
+        let xcb = &state.xcb_connection;
+        let atoms = &state.atoms;
+        let Some(drag) = state.file_drag.as_mut() else {
+            return;
+        };
+        let root = xcb.setup().roots[state.x_root_index].root;
+        let target = xdnd_target(xcb, atoms, root, x, y);
+        if target.map(|(window, _)| window) != drag.target.map(|(window, _)| window) {
+            if let Some((window, _)) = drag.target.take() {
+                send(xcb, window, atoms.XdndLeave, [drag.window, 0, 0, 0, 0]);
+            }
+            (drag.asked, drag.accepted, drag.moved) = (false, false, None);
+            if let Some((window, version)) = target {
+                let version = version.min(5) << 24;
+                send(
+                    xcb,
+                    window,
+                    atoms.XdndEnter,
+                    [drag.window, version, atoms.TextUriList, 0, 0],
+                );
+                drag.target = target;
+            }
+        }
+        if drag.target.is_some() {
+            match drag.asked {
+                true => drag.moved = Some((x, y, time)),
+                false => ask(xcb, atoms, drag, x, y, time),
+            }
+        }
+        xcb.flush().log_err();
+    }
+
+    /// The left button was let go at `time`.
+    pub(crate) fn file_drag_released(&self, time: u32) {
+        let let_go = {
+            let mut state = self.0.borrow_mut();
+            let state = &mut *state;
+            let Some(drag) = state.file_drag.as_mut() else {
+                return;
+            };
+            drag.held = false;
+            state
+                .xcb_connection
+                .ungrab_pointer(x11rb::CURRENT_TIME)
+                .log_err();
+            state.xcb_connection.flush().log_err();
+            match drag.asked {
+                // Once it answers.
+                true => {
+                    drag.released = Some(time);
+                    false
+                }
+                false => true,
+            }
+        };
+        if let_go {
+            self.file_drag_let_go(time);
+        }
+    }
+
+    /// Drops the file on the target if it accepted it where the pointer was let go, or else ends
+    /// the drag with nothing taking it.
+    fn file_drag_let_go(&self, time: u32) {
+        {
+            let mut state = self.0.borrow_mut();
+            let state = &mut *state;
+            let (xcb, atoms) = (&state.xcb_connection, &state.atoms);
+            let Some(drag) = state.file_drag.as_mut() else {
+                return;
+            };
+            if let Some((window, _)) = drag.target {
+                // Until the target says it's finished with it.
+                if drag.accepted {
+                    send(xcb, window, atoms.XdndDrop, [drag.window, 0, time, 0, 0]);
+                    xcb.flush().log_err();
+                    return;
+                }
+                send(xcb, window, atoms.XdndLeave, [drag.window, 0, 0, 0, 0]);
+                xcb.flush().log_err();
+            }
+            state.file_drag = None;
+        }
+        crate::linux::file_drag_ended(false);
+    }
+
+    /// Handles `message` if it's the target's answer, XdndStatus or XdndFinished.
+    pub(crate) fn file_drag_message(&self, message: &ClientMessageEvent) -> bool {
+        let (let_go, ended) = {
+            let mut state = self.0.borrow_mut();
+            let state = &mut *state;
+            let (xcb, atoms) = (&state.xcb_connection, &state.atoms);
+            let Some(drag) = state.file_drag.as_mut() else {
+                return false;
+            };
+            let [from, flags, ..] = message.data.as_data32();
+            // One from a target the pointer has left is for nothing.
+            let from_target = drag.target.is_some_and(|(window, _)| window == from);
+            if message.type_ == atoms.XdndStatus {
+                let mut let_go = None;
+                if from_target && drag.asked {
+                    drag.asked = false;
+                    drag.accepted = flags & 1 == 1;
+                    let_go = drag.released.take();
+                    if let_go.is_none()
+                        && let Some((x, y, time)) = drag.moved.take()
+                    {
+                        ask(xcb, atoms, drag, x, y, time);
+                        xcb.flush().log_err();
+                    }
+                }
+                (let_go, None)
+            } else if message.type_ == atoms.XdndFinished {
+                let mut ended = None;
+                if from_target && !drag.held {
+                    let version = drag.target.map_or(0, |(_, version)| version);
+                    state.file_drag = None;
+                    // Before version 5, a target that finished took it.
+                    ended = Some(version < 5 || flags & 1 == 1);
+                }
+                (None, ended)
+            } else {
+                return false;
+            }
+        };
+        if let Some(time) = let_go {
+            self.file_drag_let_go(time);
+        }
+        if let Some(taken) = ended {
+            crate::linux::file_drag_ended(taken);
+        }
+        true
+    }
+
+    /// Answers a target's request for the dragged file, as `text/uri-list`.
+    pub(crate) fn file_drag_selection(&self, request: &SelectionRequestEvent) {
+        let state = self.0.borrow();
+        let (xcb, atoms) = (&state.xcb_connection, &state.atoms);
+        let Some(drag) = state.file_drag.as_ref() else {
+            return;
+        };
+        if request.owner != drag.window || request.selection != atoms.XdndSelection {
+            return;
+        }
+        // A requestor of before ICCCM 2 names no property.
+        let property = match request.property {
+            x11rb::NONE => request.target,
+            property => property,
+        };
+        let given = request.target == atoms.TextUriList
+            && (xcb.change_property(
+                PropMode::REPLACE,
+                request.requestor,
+                property,
+                atoms.TextUriList,
+                8,
+                drag.uri_list.len() as u32,
+                &drag.uri_list,
+            ))
+            .log_err()
+            .is_some();
+        let answer = SelectionNotifyEvent {
+            response_type: xproto::SELECTION_NOTIFY_EVENT,
+            sequence: 0,
+            time: request.time,
+            requestor: request.requestor,
+            selection: request.selection,
+            target: request.target,
+            property: if given { property } else { x11rb::NONE },
+        };
+        xcb.send_event(false, request.requestor, EventMask::NO_EVENT, answer)
+            .log_err();
+        xcb.flush().log_err();
+    }
+}
+
+/// Tells the target the pointer is at (x, y) on the root, at `time`, and that the file would be
+/// copied there.
+fn ask(xcb: &XCBConnection, atoms: &XcbAtoms, drag: &mut FileDrag, x: i16, y: i16, time: u32) {
+    let Some((window, _)) = drag.target else {
+        return;
+    };
+    let at = (x as u16 as u32) << 16 | y as u16 as u32;
+    send(
+        xcb,
+        window,
+        atoms.XdndPosition,
+        [drag.window, 0, at, time, atoms.XdndActionCopy],
+    );
+    drag.asked = true;
+}
+
+/// The window at (x, y) on `root` that takes XDND, with its version: the first one down from the
+/// root that says so, a top-level window, inside any window manager's frame.
+fn xdnd_target(
+    xcb: &XCBConnection,
+    atoms: &XcbAtoms,
+    root: xproto::Window,
+    x: i16,
+    y: i16,
+) -> Option<(xproto::Window, u32)> {
+    let mut window = root;
+    loop {
+        window = xcb
+            .translate_coordinates(root, window, x, y)
+            .ok()?
+            .reply()
+            .ok()?
+            .child;
+        if window == x11rb::NONE {
+            return None;
+        }
+        let aware = (xcb.get_property(false, window, atoms.XdndAware, AtomEnum::ATOM, 0, 1))
+            .ok()?
+            .reply()
+            .ok()?;
+        if let Some(version) = aware.value32().and_then(|mut values| values.next()) {
+            return Some((window, version));
+        }
+    }
+}
+
+fn send(xcb: &XCBConnection, to: xproto::Window, type_: xproto::Atom, data: [u32; 5]) {
+    let message = ClientMessageEvent::new(32, to, type_, data);
+    xcb.send_event(false, to, EventMask::NO_EVENT, message)
+        .log_err();
+}
