+/// A one-shot timerfd that refreshes the window at the display's rate while GPUI asks it to: GPUI
+/// wakes it when the window turns dirty or wants another frame, so an idle window never wakes the
+/// embedder, as a periodic refresh would at the display's rate.
+pub(crate) struct EmbeddedTick {
+    fd: std::os::fd::OwnedFd,
+    period: std::time::Duration,
+    last: std::cell::Cell<std::time::Instant>,
+    armed: std::cell::Cell<bool>,
