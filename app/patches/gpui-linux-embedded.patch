+    vertical: ScrollAxisState,
+    /// Whether fingers lifting from it send a scroll of nothing, so a pause while they rest on the
+    /// touchpad doesn't end their scroll (`FingerScrolls`): Xwayland's devices and libinput's
+    /// driver's do.
+    lifts: bool,
+}
+
+/// Fingers scrolling on a touchpad. XInput's smooth scrolling has no begin or end, so the first
+/// scroll that isn't a wheel's starts it, and the scroll of nothing that libinput's driver and
+/// Xwayland send as the fingers lift ends it, or for a driver that sends none (synaptics, evdev),
+/// a quiet spell. GPUI's other platforms say where fingers start and lift, as a swipe needs.
+#[derive(Default)]
+struct FingerScrolls(Option<FingerScroll>);
+
+struct FingerScroll {
+    /// The window it started over, which hears all of it.
+    window: xproto::Window,
+    device: xinput::DeviceId,
+    /// Whether its device sends a lift (`PointerDeviceState::lifts`).
+    lifts: bool,
+    position: Point<Pixels>,
+    modifiers: Modifiers,
+    last: Instant,
+}
+
+/// A finger scroll's event, with the window it goes to.
+type FingerEvent = (xproto::Window, gpui::ScrollEvent);
+
+impl FingerScrolls {
+    /// A scroll of `lines` from `device` over `window` at `now`: the finger scroll's events, after
+    /// an end to another device's, or `None` for a wheel's.
+    fn scroll(
+        &mut self,
+        window: xproto::Window,
+        device: xinput::DeviceId,
+        lifts: bool,
+        lines: Point<f64>,
+        position: Point<Pixels>,
+        modifiers: Modifiers,
+        now: Instant,
+    ) -> Option<Vec<FingerEvent>> {
+        // A scroll of nothing is the fingers lifting, which no wheel sends.
+        if lines.x == 0. && lines.y == 0. {
+            return Some(Vec::from_iter(self.end_if(|fingers| fingers.device == device)));
+        }
+        let scrolling = self.0.as_ref().is_some_and(|fingers| fingers.device == device);
+        if !scrolling && is_wheel(lines) {
+            return None;
+        }
+        // Another device's fingers have let go.
+        let mut events = Vec::from_iter(self.end_if(|fingers| fingers.device != device));
+        let phase = if self.0.is_some() { TouchPhase::Moved } else { TouchPhase::Started };
+        let fingers = self.0.get_or_insert(FingerScroll {
+            window,
+            device,
+            lifts,
+            position,
+            modifiers,
+            last: now,
+        });
+        if fingers.window == window {
+            fingers.position = position;
+        }
+        (fingers.modifiers, fingers.last) = (modifiers, now);
+        events.push((
+            fingers.window,
+            finger_scroll_event(fingers.position, lines, modifiers, phase),
+        ));
+        Some(events)
+    }
+
+    /// When the scroll ends if its device sends nothing more: a quiet spell after its last.
+    fn due(&self) -> Option<Instant> {
+        let fingers = self.0.as_ref()?;
+        Some(fingers.last + if fingers.lifts { FINGER_SCROLL_LOST } else { FINGER_SCROLL_QUIET })
+    }
+
+    /// Ends the scroll if `ends` it: the window it started over hears it end, with no delta.
+    fn end_if(&mut self, ends: impl FnOnce(&FingerScroll) -> bool) -> Option<FingerEvent> {
+        let fingers = self.0.take_if(|fingers| ends(fingers))?;
+        let event = finger_scroll_event(
+            fingers.position,
+            Point::default(),
+            fingers.modifiers,
+            TouchPhase::Ended,
+        );
+        Some((fingers.window, event))
+    }
+}
+
+/// A finger scroll's pixels for each of XInput's lines, as on Wayland: Xwayland moves the
+/// valuator a tenth of a click for each of Wayland's pixels, which GPUI triples there as it does
+/// lines here.
+const FINGER_PIXELS_PER_LINE: f64 = 10.;
+/// The quiet spell that ends a finger scroll from a device that sends no lift: a touchpad reports
+/// every 7 to 12 ms while the fingers move.
+const FINGER_SCROLL_QUIET: Duration = Duration::from_millis(60);
+/// The one for a device that does, after which a lift that went to another window is taken as
+/// heard.
+const FINGER_SCROLL_LOST: Duration = Duration::from_secs(1);
+
+#[derive(Debug, Default)]
+struct ScrollAxisState {
+    /// Valuator number for looking up this axis's scroll value.
+    valuator_number: Option<u16>,
+    /// Conversion factor from scroll units to lines.
+    multiplier: f32,
+    /// Last scroll value for calculating scroll delta.
+    ///
+    /// This gets set to `None` whenever it might be invalid - when devices change or when window focus changes.
+    /// The logic errs on the side of invalidating this, since the consequence is just skipping the delta of one scroll event.
+    /// The consequence of not invalidating it can be large invalid deltas, which are much more user visible.
+    scroll_value: Option<f64>,
+}
