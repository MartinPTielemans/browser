+
+impl EmbeddedTick {
+    pub(crate) fn new(period: std::time::Duration) -> anyhow::Result<Rc<Self>> {
+        use std::os::fd::FromRawFd as _;
+        // SAFETY: a plain system call; the descriptor is owned from here on.
+        let fd = unsafe {
+            libc::timerfd_create(
+                libc::CLOCK_MONOTONIC,
+                libc::TFD_NONBLOCK | libc::TFD_CLOEXEC,
+            )
+        };
+        anyhow::ensure!(fd >= 0, "Failed to create window refresh timer");
+        let tick = Rc::new(Self {
+            // SAFETY: as above.
+            fd: unsafe { std::os::fd::OwnedFd::from_raw_fd(fd) },
+            period,
+            last: std::cell::Cell::new(std::time::Instant::now() - period),
+            armed: std::cell::Cell::new(false),
+        });
+        // The first frame.
+        tick.wake();
+        Ok(tick)
+    }
+
+    /// Fires a period after the last tick, or now if that's passed.
+    pub(crate) fn wake(&self) {
+        use std::os::fd::AsRawFd as _;
+        if self.armed.replace(true) {
+            return;
+        }
+        let due = (self.last.get() + self.period)
+            .saturating_duration_since(std::time::Instant::now())
+            .max(std::time::Duration::from_nanos(1));
+        let spec = libc::itimerspec {
+            it_interval: libc::timespec {
+                tv_sec: 0,
+                tv_nsec: 0,
+            },
+            it_value: libc::timespec {
+                tv_sec: due.as_secs() as _,
+                tv_nsec: due.subsec_nanos() as _,
+            },
+        };
+        // SAFETY: a plain system call on the timerfd this owns.
+        unsafe { libc::timerfd_settime(self.fd.as_raw_fd(), 0, &spec, std::ptr::null_mut()) };
+    }
+
+    /// Takes the expiration, before the refresh that may wake it again.
+    pub(crate) fn fired(&self) {
+        use std::os::fd::AsRawFd as _;
+        let mut expirations = 0u64;
+        // SAFETY: reads the 8 bytes a timerfd gives into a u64.
+        unsafe {
+            libc::read(self.fd.as_raw_fd(), (&raw mut expirations).cast(), 8);
+        }
+        self.armed.set(false);
+        self.last.set(std::time::Instant::now());
+    }
+}
