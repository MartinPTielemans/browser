+/// A file descriptor that's readable while GPUI has events to dispatch, once it has launched
+/// embedded.
+pub fn embedded_fd() -> Option<std::os::fd::RawFd> {
+    EMBEDDED_LOOP.with_borrow(|event_loop| event_loop.as_ref().map(|l| l.as_fd().as_raw_fd()))
+}
+
+/// Dispatches what GPUI has ready, without waiting. Timers wake [`embedded_fd`] too.
+pub fn dispatch_embedded() {
+    EMBEDDED_LOOP.with(|event_loop| {
+        // A callback that runs a nested loop of the embedder's doesn't dispatch GPUI's again.
+        let Ok(mut event_loop) = event_loop.try_borrow_mut() else {
+            return;
+        };
+        if let Some(event_loop) = event_loop.as_mut() {
+            event_loop.dispatch(Some(Duration::ZERO), &mut ()).log_err();
+        }
+    });
+    let platform = EMBEDDED_PLATFORM.get();
+    if !platform.is_null() {
+        // SAFETY: the platform outlives the app, which the embedder keeps for as long as it
+        // dispatches, and both are only used on this thread.
+        let platform = unsafe { &*platform };
+        platform.apply_pending_mode();
+        // A frame's requests, such as Vulkan's to present it, read events into xcb's queue as a
+        // runnable's do.
+        let after = platform.common.borrow().after_runnable.clone();
+        if let Some(after) = after {
+            after();
+        }
+    }
+    #[cfg(feature = "wayland")]
+    crate::linux::wayland::dispatch_embedded_queue();
+}
+
+/// What `dispatch_embedded` does, for an embedder that has just read and dispatched its Wayland
+/// display (`embed_wayland`): until it prepares its next read, GPUI may make a roundtrip on it, as
+/// Vulkan does to set a surface up and may to present, so GPUI's frames wait for this.
+pub fn dispatch_embedded_after_read() {
+    EMBEDDER_HAS_READ.set(true);
+    dispatch_embedded();
+    crate::linux::overlay::run_after_read();
+    #[cfg(feature = "wayland")]
+    crate::linux::wayland::run_deferred_frames();
+    EMBEDDER_HAS_READ.set(false);
+}
+
+/// Whether the embedder has read its Wayland display, and prepares no read now.
+pub(crate) fn embedder_has_read() -> bool {
+    EMBEDDER_HAS_READ.get()
+}
+
+/// The loop GPUI's events are dispatched on, once it has launched embedded.
+pub(crate) fn embedded_loop_handle() -> Option<LoopHandle<'static, ()>> {
+    let platform = EMBEDDED_PLATFORM.get();
+    // SAFETY: as in `dispatch_embedded`.
+    (!platform.is_null()).then(|| unsafe { &*platform }.loop_handle.clone())
+}
+
+/// Runs `f` on GPUI's display connection once it has launched embedded, unless it's in use.
+pub(crate) fn with_embedded_connection<R>(f: impl FnOnce(&DisplayConnection) -> R) -> Option<R> {
+    let platform = EMBEDDED_PLATFORM.get();
+    if platform.is_null() {
+        return None;
+    }
+    // SAFETY: as in `dispatch_embedded`.
+    let connection = unsafe { &*platform }.connection.try_borrow().ok()?;
+    Some(f(&connection))
+}
+
+/// Makes an unmapped X11 window for the next window GPUI opens to fill (`open_next_window_in`),
+/// for an embedder to put in a window of its own. `None` unless GPUI is on X11.
+pub fn new_host_window() -> Option<u32> {
+    let platform = EMBEDDED_PLATFORM.get();
+    if platform.is_null() {
+        return None;
+    }
+    // SAFETY: as in `dispatch_embedded`.
+    let connection = unsafe { &*platform }.connection.borrow();
+    match &*connection {
+        #[cfg(feature = "x11")]
+        DisplayConnection::X11(x11) => x11.0.borrow().new_host_window().log_err(),
+        _ => None,
+    }
+}
