+/// A touchpad swipe under way over an embedder's surface, and how far the fingers have gone.
+struct EmbedderSwipe {
+    parent: usize,
+    at: Point<Pixels>,
+    fingers: u32,
+    x: f64,
+    y: f64,
+}
