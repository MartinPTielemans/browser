+            zwp_pointer_gesture_swipe_v1::Event::Begin {
+                surface, fingers, ..
+            } => {
+                let parent = surface.id().as_ptr() as usize;
+                state.swipe = (state.embedder_pointer)
+                    .filter(|&(pointer_in, _)| pointer_in == parent)
+                    .map(|(parent, at)| EmbedderSwipe { parent, at, fingers, x: 0., y: 0. });
