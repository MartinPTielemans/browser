+    /// Stacks the overlay `under` directly under the overlay `over`, both over the same window.
+    pub(crate) fn place_overlay_under(
+        &self,
+        under: xproto::Window,
+        over: xproto::Window,
+    ) -> anyhow::Result<()> {
+        let place = (xproto::ConfigureWindowAux::new())
+            .sibling(over)
+            .stack_mode(xproto::StackMode::BELOW);
+        self.xcb_connection.configure_window(under, &place)?;
+        self.xcb_connection.flush()?;
+        Ok(())
+    }
