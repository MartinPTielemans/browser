+/// Whether the key `key`, pressed or released as `key_state` says, is held for an overlay
+/// (`hold_keys`), which it then is. A hold that no overlay showed for in time ends with its keys.
+fn holds_key(state: &WaylandClientState, key: u32, key_state: wl_keyboard::KeyState) -> bool {
+    HELD_KEYS.with_borrow_mut(|slot| {
+        let Some(held) = slot.as_mut() else {
+            return false;
+        };
+        if expired(held) {
+            *slot = None;
+            return false;
+        }
+        let Some(keymap_state) = state.keymap_state.as_ref() else {
+            return false;
+        };
+        let keycode = Keycode::from(key + MIN_KEYCODE);
+        if keymap_state.key_get_one_sym(keycode).is_modifier_key() {
+            return false;
+        }
+        let keystroke = keystroke_from_xkb(keymap_state, state.modifiers, keycode);
+        let input = match key_state {
+            wl_keyboard::KeyState::Pressed => PlatformInput::KeyDown(KeyDownEvent {
+                keystroke,
+                is_held: false,
+                prefer_character_input: false,
+            }),
+            wl_keyboard::KeyState::Released => PlatformInput::KeyUp(KeyUpEvent { keystroke }),
+            _ => return false,
+        };
+        if !held.after {
+            held.after = match (&input, &held.shortcut) {
+                (PlatformInput::KeyDown(down), Some(shortcut)) => {
+                    down.keystroke.key == shortcut.key
+                        && down.keystroke.modifiers == shortcut.modifiers
+                }
+                _ => false,
+            };
+            return false;
+        }
+        held.keys.push(input);
+        true
+    })
+}
