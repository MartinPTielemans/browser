+/// Starts the data device's drag of `uri_list`, a `text/uri-list`, from the surface the left
+/// button is held in (`file_drag::start_file_drag`).
+pub(crate) fn start_file_drag(uri_list: String) -> bool {
+    let Some(client) = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade()) else {
+        return false;
+    };
+    let mut state = client.borrow_mut();
+    let Some(window) = state.mouse_focused_window.clone() else {
+        return false;
+    };
+    let (Some(manager), Some(device)) = (
+        state.globals.data_device_manager.as_ref(),
+        state.data_device.as_ref(),
+    ) else {
+        return false;
+    };
+    let serial = state.serial_tracker.get(SerialKind::MousePress);
+    let source = manager.create_data_source(&state.globals.qh, DataSourceKind::Drag);
+    source.offer(FILE_LIST_MIME_TYPE.to_string());
+    source.set_actions(DndAction::Copy);
+    device.start_drag(Some(&source), &window.surface(), None, serial.as_raw());
+    state.external_drag = Some(ExternalDrag {
+        source,
+        bytes: uri_list.into_bytes(),
+        window: window.clone(),
+    });
+    drop(state);
+    flush(&window);
+    true
+}
