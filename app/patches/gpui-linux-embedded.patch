+/// Has the compositor answer GPUI on the embedder's display, which the embedder reads, and then
+/// dispatches GPUI (`crate::linux::dispatch_embedded_after_read`).
+pub(crate) fn wake_after_read() {
+    let Some(client) = EMBEDDED_CLIENT.with_borrow(|client| client.as_ref()?.upgrade()) else {
+        return;
+    };
+    let Some(window) = embedded_windows().into_iter().next() else {
+        return;
+    };
+    let Some(backend) = window.surface().backend().upgrade() else {
+        return;
+    };
+    let connection = Connection::from_backend(backend);
+    let Ok(qh) = client.try_borrow().map(|client| client.globals.qh.clone()) else {
+        return;
+    };
+    // A callback for no surface, which its handler ignores.
+    connection.display().sync(&qh, ObjectId::null());
+    connection.flush().ok();
+}
