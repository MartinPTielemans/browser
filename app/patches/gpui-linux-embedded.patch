+    /// each phase but Moved and when, a wheel's as Lines, and how many moves.
+    fn replay(lift: bool, scrolls: &[(f64, u16, f64)]) -> (Vec<(f64, &'static str)>, usize) {
+        let start = Instant::now();
+        let ms = |at: Instant| (at - start).as_secs_f64() * 1000.;
+        let mut fingers = FingerScrolls::default();
+        let (mut heard, mut moves) = (Vec::new(), 0);
+        // A wheel's scroll is `None`.
+        let mut hear = |at: Instant, events: Option<Vec<FingerEvent>>| {
+            let Some(events) = events else {
+                return heard.push((ms(at), "wheel"));
+            };
+            for (_, event) in events {
+                match event.touch_phase {
+                    TouchPhase::Started => heard.push((ms(at), "started")),
+                    TouchPhase::Moved => moves += 1,
+                    _ => heard.push((ms(at), "ended")),
+                }
+            }
+        };
+        for &(time, device, lines) in scrolls {
+            let at = start + Duration::from_secs_f64(time / 1000.);
+            // The timer fires at the end of the quiet spell.
+            if let Some(due) = fingers.due().filter(|&due| due <= at) {
+                hear(due, Some(Vec::from_iter(fingers.end_if(|_| true))));
+            }
+            let lines = Point::new(lines, 0.);
+            let (position, modifiers) = (Point::default(), Modifiers::default());
+            hear(at, fingers.scroll(1, device, lift, lines, position, modifiers, at));
+        }
+        if let Some(due) = fingers.due() {
+            hear(due, Some(Vec::from_iter(fingers.end_if(|_| true))));
+        }
+        let heard = heard.into_iter().map(|(at, what)| ((at * 1000.).round() / 1000., what));
+        (heard.collect(), moves)
+    }
+
+    fn resting(lift: Option<f64>) -> Vec<(f64, u16, f64)> {
+        let moving = RESTING.iter().map(|&time| (time, 8, 0.52969));
+        moving.chain(lift.map(|time| (time, 8, 0.))).collect()
+    }
+
+    #[test]
+    fn fingers_start_where_they_scroll_and_end_where_they_lift() {
+        // Resting before the lift doesn't end the scroll on a device that sends one.
+        let (heard, moves) = replay(true, &resting(Some(LIFT)));
+        assert_eq!(heard, [(0., "started"), (LIFT, "ended")]);
+        assert_eq!(moves, 28);
+        // Without the lift, which went to another window, it ends a second after the last.
+        let (heard, _) = replay(true, &resting(None));
+        assert_eq!(heard, [(0., "started"), (1340.521, "ended")]);
+        // A driver that sends no lift (synaptics, evdev): a quiet spell longer than the pad's
+        // gaps, such as the 24 ms in these, ends it.
+        let (heard, moves) = replay(false, &resting(None));
+        assert_eq!(heard, [(0., "started"), (400.521, "ended")]);
+        assert_eq!(moves, 28);
+        // A lift with no scroll, or from another device, ends nothing.
+        assert_eq!(replay(true, &[(0., 8, 0.)]).0, []);
+        let (heard, _) = replay(true, &[(0., 8, 1.31), (12., 9, 0.), (24., 8, 0.)]);
+        assert_eq!(heard, [(0., "started"), (24., "ended")]);
+        // Another device's fingers end the first's.
+        let (heard, _) = replay(true, &[(0., 8, 1.31), (12., 9, 1.31), (24., 9, 0.)]);
+        assert_eq!(heard, [(0., "started"), (12., "ended"), (12., "started"), (24., "ended")]);
+    }
+
+    #[test]
+    fn a_wheel_never_starts_a_finger_scroll() {
+        // Xwayland's wheel, two ticks 60 ms apart, three lines each.
+        let (heard, _) = replay(true, &[(0., 8, -3.), (60.07, 8, -3.)]);
+        assert_eq!(heard, [(0., "wheel"), (60.07, "wheel")]);
+        // libinput's driver's high-resolution wheel, in 120ths of a click.
+        let (heard, _) = replay(true, &[(0., 8, 0.75), (8., 8, 1.5), (16., 8, -0.025)]);
+        assert_eq!(heard, [(0., "wheel"), (8., "wheel"), (16., "wheel")]);
+        // A finger's tick that happens to be whole 120ths, once the fingers are scrolling, isn't.
+        let (heard, moves) = replay(true, &[(0., 8, 0.52969), (12., 8, 0.75), (24., 8, 0.)]);
+        assert_eq!((heard, moves), (vec![(0., "started"), (24., "ended")], 1));
+    }
+
