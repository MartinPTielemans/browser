+    /// Shows GPUI's unmapped window `view` over the embedder's `parent` (`crate::linux::overlay`):
+    /// a window of its own, which no window manager takes, in the shape of `outline`. Not a child of
+    /// `parent`, as an X server doesn't blend a child window with what's under it, where a
+    /// compositor blends a window's edges with whatever is. A `panel` is a child of the window
+    /// `parent` is in instead, over `parent`, so it moves with that window and stays under other
+    /// windows, with its edges unblended. With `keyboard` it takes the input focus, and this
+    /// returns the window that had it.
+    pub(crate) fn show_overlay(
+        &self,
+        view: xproto::Window,
+        parent: xproto::Window,
+        bounds: Bounds<Pixels>,
+        outline: &[crate::linux::overlay::Corner],
+        keyboard: bool,
+        panel: bool,
+    ) -> anyhow::Result<xproto::Window> {
+        let xcb = &self.xcb_connection;
+        if panel {
+            // Not `parent` itself, whose shape has holes where the embedder's pages show.
+            let within = xcb.query_tree(parent)?.reply()?.parent;
+            xcb.reparent_window(view, within, 0, 0)?;
+        } else {
+            xcb.change_window_attributes(
+                view,
+                &xproto::ChangeWindowAttributesAux::new().override_redirect(1),
+            )?;
+            // A pop-up, as GPUI's own are, so that a compositor that runs X's clients, as sway's
+            // and Hyprland's Xwayland do, doesn't give it its keyboard focus: it would take that
+            // back to the browser window as the overlay hides, from whichever overlay has the input
+            // focus by then. A menu says it's one (`overlay_is_menu`).
+            if !crate::linux::overlay::is_menu(view as usize) {
+                xcb.change_property32(
+                    xproto::PropMode::REPLACE,
+                    view,
+                    self.atoms._NET_WM_WINDOW_TYPE,
+                    xproto::AtomEnum::ATOM,
+                    &[self.atoms._NET_WM_WINDOW_TYPE_NOTIFICATION],
+                )?;
+            }
+            // The embedder's, whose moves and raises GPUI hears of; not one of GPUI's, whose events
+            // it already has.
+            let top = self.top_level(parent)?;
+            if !self.windows.contains_key(&top) {
+                let watch = xproto::EventMask::STRUCTURE_NOTIFY;
+                xcb.change_window_attributes(
+                    top,
+                    &xproto::ChangeWindowAttributesAux::new().event_mask(watch),
+                )?;
+            }
