+/// The window that gets the keys the compositor gives `focused`: an embedder's overlay that has
+/// them, which the compositor doesn't know of, else `focused` unless they're the embedder's.
+fn key_window(
+    state: &WaylandClientState,
+    focused: Option<WaylandWindowStatePtr>,
+) -> Option<WaylandWindowStatePtr> {
+    let focused = focused?;
+    if let Some(overlay) = crate::linux::overlay::keyboard_overlay() {
+        return window_with_surface(state, overlay);
+    }
+    (!keys_are_embedders(&focused)).then_some(focused)
+}
