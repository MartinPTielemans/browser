+/// The polygon through `corners` with each rounded by its radius, its arcs in short lines.
+fn rounded_polygon(corners: &[(f32, f32, f32)]) -> Vec<(f32, f32)> {
+    let count = corners.len();
+    let at = |index: usize| (corners[index % count].0, corners[index % count].1);
+    let mut points = Vec::new();
+    for index in 0..count {
+        let here = at(index);
+        let radius = corners[index].2;
+        let unit = |to: (f32, f32)| {
+            let (dx, dy) = (to.0 - here.0, to.1 - here.1);
+            let length = dx.hypot(dy).max(f32::EPSILON);
+            (dx / length, dy / length)
+        };
+        let (before, after) = (unit(at(index + count - 1)), unit(at(index + 1)));
+        // The arc meets each side as far along it as the radius over the tangent of half the angle
+        // between them, and its centre is on the line halving that angle.
+        let half = (before.0 * after.0 + before.1 * after.1)
+            .clamp(-1., 1.)
+            .acos()
+            / 2.;
+        let (bx, by) = (before.0 + after.0, before.1 + after.1);
+        let bisector = bx.hypot(by);
+        if radius <= 0. || bisector < 1e-4 {
+            points.push(here);
+            continue;
+        }
+        let along = radius / half.tan();
+        let distance = radius / half.sin();
+        let centre = (
+            here.0 + bx / bisector * distance,
+            here.1 + by / bisector * distance,
+        );
+        let angle = |point: (f32, f32)| (point.1 - centre.1).atan2(point.0 - centre.0);
+        let start = angle((here.0 + before.0 * along, here.1 + before.1 * along));
+        let end = angle((here.0 + after.0 * along, here.1 + after.1 * along));
+        let mut sweep = end - start;
+        if sweep > std::f32::consts::PI {
+            sweep -= std::f32::consts::TAU;
+        } else if sweep < -std::f32::consts::PI {
+            sweep += std::f32::consts::TAU;
+        }
+        // Within about a tenth of a pixel of the arc.
+        let steps = (radius.sqrt() * 2.).ceil().max(2.) as usize;
+        for step in 0..=steps {
+            let a = start + sweep * step as f32 / steps as f32;
+            points.push((centre.0 + radius * a.cos(), centre.1 + radius * a.sin()));
+        }
+    }
+    points
+}
