+/// The keys GPUI has after a shortcut that opens an overlay with the keyboard (`hold_keys`). Every
+/// key reaches both the embedder and GPUI, and the shortcut's press is the one place in the keys
+/// both know: the embedder's copies of the keys after it are its page's only if no overlay takes
+/// them, and GPUI's go to the overlay that does. For a shortcut GPUI handles itself, they're those
+/// after the press it's handling.
+struct HeldKeys {
+    /// None for one GPUI had itself, whose press it was handling (`hold_keys`).
+    shortcut: Option<Keystroke>,
+    since: Instant,
+    /// Whether GPUI has had the shortcut's press, after which it holds the keys.
+    after: bool,
+    keys: Vec<PlatformInput>,
+    /// The overlay that takes them (`give_held_keys`).
+    to: Option<usize>,
+}
+
+thread_local! {
+    static HELD_KEYS: RefCell<Option<HeldKeys>> = const { RefCell::new(None) };
+}
+
+/// As long as the embedder holds them (bc_hold_keys): past it, its page kept the shortcut.
+const HOLD_KEYS_FOR: Duration = Duration::from_millis(400);
+
+pub(crate) fn hold_keys(shortcut: Option<&Keystroke>) {
+    if EMBEDDED_CLIENT.with_borrow(|client| client.is_none()) {
+        return;
+    }
+    HELD_KEYS.set(Some(HeldKeys {
+        shortcut: shortcut.cloned(),
+        since: Instant::now(),
+        after: shortcut.is_none(),
+        keys: Vec::new(),
+        to: None,
+    }));
+}
+
+pub(crate) fn give_held_keys(view: usize) -> bool {
+    HELD_KEYS.with_borrow_mut(|held| {
+        if held.as_ref().is_some_and(expired) {
+            *held = None;
+        }
+        if let Some(held) = held.as_mut() {
+            held.to = Some(view);
+        }
+        held.is_some()
+    })
+}
+
+fn expired(held: &HeldKeys) -> bool {
+    held.since.elapsed() > HOLD_KEYS_FOR
+}
+
+/// Gives the overlay that took the keys held (`give_held_keys`) them once it shows with the
+/// keyboard, before GPUI gives it those typed later.
+pub(crate) fn deliver_held_keys() {
+    let ready = crate::linux::overlay::keyboard_overlay();
+    let held = HELD_KEYS.with_borrow_mut(|held| {
+        let to = held.as_ref()?.to?;
+        (ready == Some(to)).then(|| held.take()).flatten()
+    });
+    let Some(held) = held else {
+        return;
+    };
+    if let Some(window) = held.to.and_then(|to| overlay_window(to as _)) {
+        for key in held.keys {
+            window.handle_input(key);
+        }
+    }
+}
