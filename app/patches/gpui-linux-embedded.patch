+impl X11ClientState {
+    fn has_xim(&self) -> bool {
+        self.ximc.is_some() && self.xim_handler.is_some()
+    }
+
+    fn take_xim(&mut self) -> Option<(X11rbClient<Rc<XCBConnection>>, XimHandler)> {
+        let ximc = self
+            .ximc
+            .take()
+            .ok_or(anyhow!("bug: XIM connection not set"))
+            .log_err()?;
+        if let Some(xim_handler) = self.xim_handler.take() {
+            Some((ximc, xim_handler))
+        } else {
+            self.ximc = Some(ximc);
+            log::error!("bug: XIM handler not set");
+            None
+        }
+    }
+
+    fn restore_xim(&mut self, ximc: X11rbClient<Rc<XCBConnection>>, xim_handler: XimHandler) {
+        self.ximc = Some(ximc);
+        self.xim_handler = Some(xim_handler);
+    }
+
+    fn update_refresh_loop(&mut self, x_window: xproto::Window) {
+        let Some(window_ref) = self.windows.get_mut(&x_window) else {
+            return;
+        };
+        let is_visible = window_ref.visibility().is_visible();
+        match (is_visible, window_ref.refresh_state.take()) {
+            (false, refresh_state @ Some(RefreshState::Hidden { .. }))
+            | (false, refresh_state @ None)
+            | (true, refresh_state @ Some(RefreshState::PeriodicRefresh { .. })) => {
+                window_ref.refresh_state = refresh_state;
+            }
+            (
+                false,
+                Some(RefreshState::PeriodicRefresh {
+                    refresh_rate,
+                    event_loop_token,
+                }),
+            ) => {
+                self.loop_handle.remove(event_loop_token);
+                window_ref.refresh_state = Some(RefreshState::Hidden { refresh_rate });
+            }
+            (true, Some(RefreshState::Hidden { refresh_rate })) => {
+                let event_loop_token = self.start_refresh_loop(x_window, refresh_rate);
+                let Some(window_ref) = self.windows.get_mut(&x_window) else {
+                    return;
+                };
+                window_ref.refresh_state = Some(RefreshState::PeriodicRefresh {
+                    refresh_rate,
+                    event_loop_token,
+                });
+            }
+            (true, None) => {
+                let Some(screen_resources) = get_reply(
+                    || "Failed to get screen resources",
+                    self.xcb_connection
+                        .randr_get_screen_resources_current(x_window),
+                )
+                .log_err() else {
+                    return;
+                };
+
+                // Ideally this would be re-queried when the window changes screens, but there
+                // doesn't seem to be an efficient / straightforward way to do this. Should also be
+                // updated when screen configurations change.
+                let mode_info = screen_resources.crtcs.iter().find_map(|crtc| {
+                    let crtc_info = self
+                        .xcb_connection
+                        .randr_get_crtc_info(*crtc, x11rb::CURRENT_TIME)
+                        .ok()?
+                        .reply()
+                        .ok()?;
+
+                    screen_resources
+                        .modes
+                        .iter()
+                        .find(|m| m.id == crtc_info.mode)
+                });
+                let refresh_rate = match mode_info {
+                    Some(mode_info) => mode_refresh_rate(mode_info),
+                    None => {
+                        log::error!(
+                            "Failed to get screen mode info from xrandr, \
+                            defaulting to 60hz refresh rate."
+                        );
+                        Duration::from_micros(1_000_000 / 60)
+                    }
+                };
+
+                let event_loop_token = self.start_refresh_loop(x_window, refresh_rate);
+                let Some(window_ref) = self.windows.get_mut(&x_window) else {
+                    return;
+                };
+                window_ref.refresh_state = Some(RefreshState::PeriodicRefresh {
+                    refresh_rate,
+                    event_loop_token,
+                });
+            }
+        }
+    }
+
+    #[must_use]
+    fn start_refresh_loop(
+        &self,
+        x_window: xproto::Window,
+        refresh_rate: Duration,
+    ) -> RegistrationToken {
+        if crate::linux::is_embedded() {
+            return self.start_embedded_refresh_loop(x_window, refresh_rate);
+        }
+        self.loop_handle
+            .insert_source(calloop::timer::Timer::immediate(), {
+                let this = self.this.clone();
+                move |mut instant, (), _| {
+                    let Some(client) = this.get_client() else {
+                        return calloop::timer::TimeoutAction::Drop;
+                    };
+                    let xcb_connection = {
+                        let mut state = client.0.borrow_mut();
+                        let xcb_connection = state.xcb_connection.clone();
+                        if let Some(window) = state.windows.get_mut(&x_window) {
+                            let window = window.window.clone();
+                            drop(state);
+                            window.refresh(RequestFrameOptions {
+                                require_presentation: false,
+                                force_render: false,
+                                signal_at: PlatformFrameSignal::capture(|| instant),
+                                signal_source: FrameRequestSource::LocalSchedule,
+                            });
+                        }
+                        xcb_connection
+                    };
+                    client.process_x11_events(&xcb_connection).log_err();
+
+                    // Take into account that some frames have been skipped
+                    let now = Instant::now();
+                    while instant < now {
+                        instant += refresh_rate;
+                    }
+                    calloop::timer::TimeoutAction::ToInstant(instant)
+                }
+            })
+            .expect("Failed to initialize window refresh timer")
+    }
+
+    /// The refresh loop on a one-shot timerfd, which wakes the event loop's file descriptor, as an
+    /// embedder that dispatches GPUI's loop when that's readable never sees calloop's own timers.
+    /// It runs only while GPUI wants a frame (`EmbeddedTick`).
+    #[must_use]
+    fn start_embedded_refresh_loop(
+        &self,
+        x_window: xproto::Window,
+        refresh_rate: Duration,
+    ) -> RegistrationToken {
+        let tick = super::window::EmbeddedTick::new(refresh_rate)
+            .expect("Failed to initialize window refresh timer");
+        if let Some(window) = self.windows.get(&x_window) {
+            *window.window.embedded_tick.borrow_mut() = Some(tick.clone());
+        }
+        self.loop_handle
+            .insert_source(
+                Generic::new(
+                    super::window::EmbeddedTickFd(tick),
+                    calloop::Interest::READ,
+                    calloop::Mode::Level,
+                ),
+                {
+                    let this = self.this.clone();
+                    move |_, tick, _| {
+                        tick.0.fired();
+                        let Some(client) = this.get_client() else {
+                            return Ok(calloop::PostAction::Remove);
+                        };
+                        let instant = Instant::now();
+                        let xcb_connection = {
+                            let mut state = client.0.borrow_mut();
+                            let xcb_connection = state.xcb_connection.clone();
+                            if let Some(window) = state.windows.get_mut(&x_window) {
+                                let window = window.window.clone();
+                                drop(state);
+                                window.refresh(RequestFrameOptions {
+                                    require_presentation: false,
+                                    force_render: false,
+                                    signal_at: PlatformFrameSignal::capture(|| instant),
+                                    signal_source: FrameRequestSource::LocalSchedule,
+                                });
+                            }
+                            xcb_connection
+                        };
+                        client.process_x11_events(&xcb_connection).log_err();
+                        Ok(calloop::PostAction::Continue)
+                    }
+                },
+            )
+            .expect("Failed to initialize window refresh timer")
+    }
+
+    /// An unmapped window for an embedder to hold GPUI's next window in
+    /// (`crate::linux::new_host_window`). Not on the root, where a window manager hears of each new
+    /// window as one of its own: wlroots 0.17's Xwayland goes on taking it for one once the embedder
+    /// has put it in its window, and puts the input focus back up to that window each time it comes
+    /// into GPUI's, as it can't tell it's the same app's (#628). It's made in a window that's never
+    /// shown, which no window manager gives the focus.
+    pub(crate) fn new_host_window(&self) -> anyhow::Result<u32> {
+        let xcb = &self.xcb_connection;
+        let screen = &xcb.setup().roots[self.x_root_index];
+        let mut parent = HOST_PARENT.get();
+        if parent == x11rb::NONE {
+            parent = xcb.generate_id()?;
+            xcb.create_window(
+                x11rb::COPY_DEPTH_FROM_PARENT,
+                parent,
+                screen.root,
+                0,
+                0,
+                1,
+                1,
+                0,
+                xproto::WindowClass::INPUT_OUTPUT,
+                x11rb::COPY_FROM_PARENT,
+                &xproto::CreateWindowAux::new(),
+            )?
+            .check()?;
+            HOST_PARENT.set(parent);
+        }
+        let window = xcb.generate_id()?;
+        xcb.create_window(
+            x11rb::COPY_DEPTH_FROM_PARENT,
+            window,
+            parent,
+            0,
+            0,
+            1,
+            1,
+            0,
+            xproto::WindowClass::INPUT_OUTPUT,
+            x11rb::COPY_FROM_PARENT,
+            &xproto::CreateWindowAux::new(),
+        )?
+        .check()?;
+        Ok(window)
+    }
+
+    /// Shows GPUI's unmapped window `view` over the embedder's `parent` (`crate::linux::overlay`):
+    /// a window of its own, which no window manager takes, in the shape of `outline`. Not a child of
+    /// `parent`, as an X server doesn't blend a child window with what's under it, where a
+    /// compositor blends a window's edges with whatever is. A `panel` is a child of the window
+    /// `parent` is in instead, over `parent`, so it moves with that window and stays under other
+    /// windows, with its edges unblended. With `keyboard` it takes the input focus, and this
+    /// returns the window that had it.
+    pub(crate) fn show_overlay(
+        &self,
+        view: xproto::Window,
+        parent: xproto::Window,
+        bounds: Bounds<Pixels>,
+        outline: &[crate::linux::overlay::Corner],
+        keyboard: bool,
+        panel: bool,
+    ) -> anyhow::Result<xproto::Window> {
+        let xcb = &self.xcb_connection;
+        if panel {
+            // Not `parent` itself, whose shape has holes where the embedder's pages show.
+            let within = xcb.query_tree(parent)?.reply()?.parent;
+            xcb.reparent_window(view, within, 0, 0)?;
+        } else {
+            xcb.change_window_attributes(
+                view,
+                &xproto::ChangeWindowAttributesAux::new().override_redirect(1),
+            )?;
+            // A pop-up, as GPUI's own are, so that a compositor that runs X's clients, as sway's
+            // and Hyprland's Xwayland do, doesn't give it its keyboard focus: it would take that
+            // back to the browser window as the overlay hides, from whichever overlay has the input
+            // focus by then. A menu says it's one (`overlay_is_menu`).
+            if !crate::linux::overlay::is_menu(view as usize) {
+                xcb.change_property32(
+                    xproto::PropMode::REPLACE,
+                    view,
+                    self.atoms._NET_WM_WINDOW_TYPE,
+                    xproto::AtomEnum::ATOM,
+                    &[self.atoms._NET_WM_WINDOW_TYPE_NOTIFICATION],
+                )?;
+            }
+            // The embedder's, whose moves and raises GPUI hears of; not one of GPUI's, whose events
+            // it already has.
+            let top = self.top_level(parent)?;
+            if !self.windows.contains_key(&top) {
+                let watch = xproto::EventMask::STRUCTURE_NOTIFY;
+                xcb.change_window_attributes(
+                    top,
+                    &xproto::ChangeWindowAttributesAux::new().event_mask(watch),
+                )?;
+            }
+        }
+        self.move_overlay(view, parent, bounds, outline, panel)?;
+        // A shadow under another overlay would be drawn opaque without a compositor.
+        if crate::linux::overlay::under(view as usize).is_some() && !self.compositor_present {
+            return Ok(x11rb::NONE);
+        }
+        xcb.map_window(view)?;
+        let mut from = x11rb::NONE;
+        if keyboard {
+            from = self.overlay_takes_focus(view, None)?;
+        }
+        xcb.flush()?;
+        Ok(from)
+    }
+
+    /// Places and sizes the overlay `view` that shows over `parent`, as `show_overlay` does.
+    pub(crate) fn move_overlay(
+        &self,
+        view: xproto::Window,
+        parent: xproto::Window,
+        bounds: Bounds<Pixels>,
+        outline: &[crate::linux::overlay::Corner],
+        panel: bool,
+    ) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        let scale = self.scale_factor;
+        let within = match panel {
+            true => xcb.query_tree(parent)?.reply()?.parent,
+            false => xcb.setup().roots[self.x_root_index].root,
+        };
+        let origin = (bounds.origin).map(|each| (f32::from(each) * scale) as i16);
+        let at = (xcb.translate_coordinates(parent, within, origin.x, origin.y)?).reply()?;
+        let (x, y) = (at.dst_x, at.dst_y);
+        let width = (f32::from(bounds.size.width) * scale).round();
+        let height = (f32::from(bounds.size.height) * scale).round();
+        let mut place = xproto::ConfigureWindowAux::new()
+            .x(x as i32)
+            .y(y as i32)
+            .width(width.max(1.) as u32)
+            .height(height.max(1.) as u32)
+            .stack_mode(xproto::StackMode::ABOVE);
+        if !panel {
+            // Directly over the top-level, under any other app's window over that.
+            let top = self.top_level(parent)?;
+            let corner = xcb.translate_coordinates(top, within, 0, 0)?.reply()?;
+            OVER.with_borrow_mut(|all| {
+                all.retain(|&(each, ..)| each != view);
+                all.push((view, top, x - corner.dst_x, y - corner.dst_y));
+            });
+            place = place.sibling(top);
+        }
+        xcb.configure_window(view, &place)?;
+        // In its outline by its own shape: with the pixels its edges touch where a compositor
+        // blends them, else those its edges mostly cover, which the X server draws opaque.
+        let outline: Vec<_> = (outline.iter())
+            .map(|&(x, y, radius)| (x * scale, y * scale, radius * scale))
+            .collect();
+        let blended = self.compositor_present && !panel;
+        xcb.shape_rectangles(
+            shape::SO::SET,
+            shape::SK::BOUNDING,
+            xproto::ClipOrdering::UNSORTED,
+            view,
+            0,
+            0,
+            &outline_rows(&outline, height as i16, blended),
+        )?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// Stacks the overlay `under` directly under the overlay `over`, both over the same window.
+    pub(crate) fn place_overlay_under(
+        &self,
+        under: xproto::Window,
+        over: xproto::Window,
+    ) -> anyhow::Result<()> {
+        let place = (xproto::ConfigureWindowAux::new())
+            .sibling(over)
+            .stack_mode(xproto::StackMode::BELOW);
+        self.xcb_connection.configure_window(under, &place)?;
+        self.xcb_connection.flush()?;
+        Ok(())
+    }
+
+    /// Has the overlay `view`'s window say it's a menu (`set_overlay_menu`).
+    pub(crate) fn overlay_is_menu(&self, view: xproto::Window) -> anyhow::Result<()> {
+        let menu = self.atoms._NET_WM_WINDOW_TYPE_POPUP_MENU;
+        let (xcb, kind) = (&self.xcb_connection, self.atoms._NET_WM_WINDOW_TYPE);
+        xcb.change_property32(
+            xproto::PropMode::REPLACE,
+            view,
+            kind,
+            xproto::AtomEnum::ATOM,
+            &[menu],
+        )?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// Makes the overlay `view` take the pointer only in `areas`, in logical pixels from its top
+    /// left, and let it through elsewhere, or take it all over its shape.
+    pub(crate) fn overlay_pointer(
+        &self,
+        view: xproto::Window,
+        areas: Option<&[Bounds<Pixels>]>,
+    ) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        match areas {
+            Some(areas) => {
+                let scale = self.scale_factor;
+                let rectangles: Vec<_> = (areas.iter())
+                    .map(|area| {
+                        let at = |pixels: Pixels| (f32::from(pixels) * scale).round();
+                        xproto::Rectangle {
+                            x: at(area.origin.x) as i16,
+                            y: at(area.origin.y) as i16,
+                            width: at(area.size.width) as u16,
+                            height: at(area.size.height) as u16,
+                        }
+                    })
+                    .collect();
+                xcb.shape_rectangles(
+                    shape::SO::SET,
+                    shape::SK::INPUT,
+                    xproto::ClipOrdering::UNSORTED,
+                    view,
+                    0,
+                    0,
+                    &rectangles,
+                )?;
+            }
+            None => {
+                xcb.shape_mask(shape::SO::SET, shape::SK::INPUT, view, 0, 0, x11rb::NONE)?;
+            }
+        }
+        xcb.flush()?;
+        Ok(())
+    }
+
+    /// Asks for the pointer's moves over the embedder's top-level that GPUI's `window` is in, beside
+    /// the embedder's own ask, to tell them from `window`'s top left, or stops asking.
+    pub(crate) fn watch_motion(&self, window: xproto::Window, watch: bool) -> anyhow::Result<()> {
+        let top = self.top_level(window)?;
+        MOTION_OVER.set(None);
+        if watch {
+            let at = self.xcb_connection.translate_coordinates(window, top, 0, 0)?.reply()?;
+            MOTION_OVER.set(Some((top, window, at.dst_x, at.dst_y)));
+        }
+        let window = top;
+        let mask = match watch {
+            true => xinput::XIEventMask::MOTION,
+            false => xinput::XIEventMask::from(0u32),
+        };
+        let masks = [xinput::EventMask {
+            deviceid: super::XINPUT_ALL_DEVICE_GROUPS,
+            mask: vec![mask],
+        }];
+        self.xcb_connection.xinput_xi_select_events(window, &masks)?;
+        self.xcb_connection.flush()?;
+        Ok(())
+    }
+
+    /// Gives the overlay `view` that shows the input focus, and returns the window that had it.
+    /// With `within`, the window it shows over, only if that one's top-level or an overlay has it,
+    /// not another app or another of the embedder's windows, and otherwise returns none.
+    pub(crate) fn overlay_takes_focus(
+        &self,
+        view: xproto::Window,
+        within: Option<xproto::Window>,
+    ) -> anyhow::Result<xproto::Window> {
+        let xcb = &self.xcb_connection;
+        let from = xcb.get_input_focus()?.reply()?.focus;
+        if let Some(within) = within
+            && !self.has_focus(from, within)?
+        {
+            return Ok(x11rb::NONE);
+        }
+        xcb.set_input_focus(xproto::InputFocus::PARENT, view, x11rb::CURRENT_TIME)?;
+        xcb.flush()?;
+        Ok(from)
+    }
+
+    /// The child of the root `window` is in, such as a window manager's frame around it.
+    fn top_level(&self, window: xproto::Window) -> anyhow::Result<xproto::Window> {
+        let mut top = window;
+        loop {
+            let tree = self.xcb_connection.query_tree(top)?.reply()?;
+            if tree.parent == tree.root || tree.parent == x11rb::NONE {
+                return Ok(top);
+            }
+            top = tree.parent;
+        }
+    }
+
+    /// Whether `focus` is an overlay that shows, or the top-level `within` is in or inside it.
+    fn has_focus(&self, focus: xproto::Window, within: xproto::Window) -> anyhow::Result<bool> {
+        // None or PointerRoot: no window of this app's has it.
+        if focus == x11rb::NONE || focus == 1 {
+            return Ok(false);
+        }
+        if crate::linux::overlay::is_shown(focus as usize) {
+            return Ok(true);
+        }
+        let xcb = &self.xcb_connection;
+        let top = self.top_level(within)?;
+        let mut each = focus;
+        while each != top {
+            let tree = xcb.query_tree(each)?.reply()?;
+            if tree.parent == tree.root || tree.parent == x11rb::NONE {
+                return Ok(false);
+            }
+            each = tree.parent;
+        }
+        Ok(true)
+    }
+
+    /// Gives the input focus back to `from` if the overlay `view` still has it, and says whether
+    /// it did.
+    pub(crate) fn overlay_gives_focus(
+        &self,
+        view: xproto::Window,
+        from: xproto::Window,
+    ) -> anyhow::Result<bool> {
+        let xcb = &self.xcb_connection;
+        if from == x11rb::NONE || xcb.get_input_focus()?.reply()?.focus != view {
+            return Ok(false);
+        }
+        xcb.set_input_focus(xproto::InputFocus::PARENT, from, x11rb::CURRENT_TIME)?;
+        xcb.flush()?;
+        Ok(true)
+    }
+
+    /// Hides the overlay `view`, giving the input focus back to `from` if the overlay still has it,
+    /// and says whether the focus went elsewhere than either, as a press outside both takes it.
+    pub(crate) fn hide_overlay(
+        &self,
+        view: xproto::Window,
+        from: xproto::Window,
+    ) -> anyhow::Result<bool> {
+        let gave = self.overlay_gives_focus(view, from)?;
+        let focus = self.xcb_connection.get_input_focus()?.reply()?.focus;
+        let elsewhere = !gave && from != x11rb::NONE && focus != view && focus != from;
+        OVER.with_borrow_mut(|all| all.retain(|&(each, ..)| each != view));
+        let xcb = &self.xcb_connection;
+        xcb.unmap_window(view)?;
+        xcb.flush()?;
+        Ok(elsewhere)
+    }
+
+    /// Shows `view`, a window of GPUI's opened with `show: false`, as a window of its own, in front
+    /// and with the input focus, centred over the top-level window `over` is in unless it's none.
+    pub(crate) fn show_window(
+        &self,
+        view: xproto::Window,
+        over: xproto::Window,
+    ) -> anyhow::Result<()> {
+        let xcb = &self.xcb_connection;
+        let root = xcb.get_geometry(view)?.reply()?.root;
+        if over != x11rb::NONE {
+            let top = self.top_level(over)?;
+            let frame = xcb.get_geometry(top)?.reply()?;
+            let corner = xcb.translate_coordinates(top, root, 0, 0)?.reply()?;
+            let own = xcb.get_geometry(view)?.reply()?;
+            let x = i32::from(corner.dst_x) + (i32::from(frame.width) - i32::from(own.width)) / 2;
+            let y = i32::from(corner.dst_y) + (i32::from(frame.height) - i32::from(own.height)) / 2;
+            xcb.configure_window(
+                view,
+                &xproto::ConfigureWindowAux::new().x(x.max(0)).y(y.max(0)),
+            )?;
+        }
+        // A window manager that keeps the focus from an app that asks for it, as sway's and
+        // Hyprland's do by default, still gives it to a window as it maps, so one that shows behind
+        // another maps again.
+        let viewable = xcb.get_window_attributes(view)?.reply()?.map_state == xproto::MapState::VIEWABLE;
+        if viewable && xcb.get_input_focus()?.reply()?.focus != view {
+            xcb.unmap_window(view)?;
+        }
+        xcb.map_window(view)?;
+        // As GPUI's activate asks: the window manager raises it and gives it the focus.
+        let message = xproto::ClientMessageEvent::new(
+            32,
+            view,
+            self.atoms._NET_ACTIVE_WINDOW,
+            [1, x11rb::CURRENT_TIME, 0, 0, 0],
+        );
+        xcb.send_event(
+            false,
+            root,
+            xproto::EventMask::SUBSTRUCTURE_REDIRECT | xproto::EventMask::SUBSTRUCTURE_NOTIFY,
+            message,
+        )?;
+        xcb.flush()?;
+        Ok(())
+    }
+
+    pub(crate) fn hide_window(&self, view: xproto::Window) -> anyhow::Result<()> {
+        self.xcb_connection.unmap_window(view)?;
+        self.xcb_connection.flush()?;
+        Ok(())
+    }
+
+    /// The size of `window`, such as the embedder's or an overlay, in logical pixels.
+    pub(crate) fn window_size(&self, window: xproto::Window) -> anyhow::Result<Size<Pixels>> {
+        let geometry = self.xcb_connection.get_geometry(window)?.reply()?;
+        Ok(size(
+            px(f32::from(geometry.width) / self.scale_factor),
+            px(f32::from(geometry.height) / self.scale_factor),
+        ))
+    }
+
+    fn get_cursor_icon(&mut self, style: CursorStyle) -> Option<xproto::Cursor> {
+        if let Some(cursor) = self.cursor_cache.get(&style) {
+            return *cursor;
+        }
+
+        let result = 'outer: {
+            let mut errors = String::new();
+            let cursor_icon_names = cursor_style_to_icon_names(style);
+            for cursor_icon_name in cursor_icon_names {
+                match self
+                    .cursor_handle
+                    .load_cursor(&self.xcb_connection, cursor_icon_name)
+                {
+                    Ok(loaded_cursor) => {
+                        if loaded_cursor != x11rb::NONE {
+                            break 'outer Ok(loaded_cursor);
+                        }
+                    }
+                    Err(err) => {
+                        errors.push_str(&err.to_string());
+                        errors.push('\n');
+                    }
+                }
+            }
+            if errors.is_empty() {
+                Err(anyhow!(
+                    "errors while loading cursor icons {:?}:\n{}",
+                    cursor_icon_names,
+                    errors
+                ))
+            } else {
+                Err(anyhow!("did not find cursor icons {:?}", cursor_icon_names))
+            }
+        };
+
+        let cursor = match result {
+            Ok(cursor) => Some(cursor),
+            Err(err) => {
+                match self
+                    .cursor_handle
+                    .load_cursor(&self.xcb_connection, DEFAULT_CURSOR_ICON_NAME)
+                {
+                    Ok(default) => {
+                        log_cursor_icon_warning(err.context(format!(
+                            "X11: error loading cursor icon, falling back on default icon '{}'",
+                            DEFAULT_CURSOR_ICON_NAME
+                        )));
+                        Some(default)
+                    }
+                    Err(default_err) => {
+                        log_cursor_icon_warning(err.context(default_err).context(format!(
+                            "X11: error loading default cursor fallback '{}'",
+                            DEFAULT_CURSOR_ICON_NAME
+                        )));
+                        None
+                    }
+                }
+            }
+        };
+
+        self.cursor_cache.insert(style, cursor);
+        cursor
+    }
+
+    fn get_or_create_invisible_cursor(&mut self) -> Option<xproto::Cursor> {
+        if let Some(cursor) = self.invisible_cursor_cache {
+            return Some(cursor);
+        }
+        let cursor = create_invisible_cursor(&self.xcb_connection)
+            .context("X11: error while creating invisible cursor")
+            .log_err()?;
+        self.invisible_cursor_cache = Some(cursor);
+        Some(cursor)
+    }
+
+    fn hide_cursor_until_mouse_moves(&mut self) {
+        if self.cursor_hidden_window.is_some() {
+            return;
+        }
+        let Some(focused_window) = self.mouse_focused_window else {
+            // No window to apply the per-window invisible cursor to.
+            return;
+        };
+        let Some(invisible_cursor) = self.get_or_create_invisible_cursor() else {
+            return;
+        };
+        check_reply(
+            || "Failed to hide cursor",
+            self.xcb_connection.change_window_attributes(
+                focused_window,
+                &ChangeWindowAttributesAux {
+                    cursor: Some(invisible_cursor),
+                    ..Default::default()
+                },
+            ),
+        )
+        .log_err();
+        self.xcb_connection.flush().log_err();
+        self.cursor_hidden_window = Some(focused_window);
+    }
+
+    fn restore_cursor_after_hide(&mut self) {
+        let Some(hidden_window) = self.cursor_hidden_window.take() else {
+            return;
+        };
+        let style = self
+            .cursor_styles
+            .get(&hidden_window)
+            .copied()
+            .unwrap_or(CursorStyle::Arrow);
+        let Some(cursor) = self.get_cursor_icon(style) else {
+            log::warn!(
+                "X11: no cursor icon available to restore {:?} after hide; cursor may stay invisible",
+                style
+            );
+            return;
+        };
+        check_reply(
+            || "Failed to restore cursor style after hide",
+            self.xcb_connection.change_window_attributes(
+                hidden_window,
+                &ChangeWindowAttributesAux {
+                    cursor: Some(cursor),
+                    ..Default::default()
+                },
+            ),
+        )
+        .log_err();
+        self.xcb_connection.flush().log_err();
+    }
+}
+
+// Adapted from:
+// https://docs.rs/winit/0.29.11/src/winit/platform_impl/linux/x11/monitor.rs.html#103-111
+pub fn mode_refresh_rate(mode: &randr::ModeInfo) -> Duration {
+    if mode.dot_clock == 0 || mode.htotal == 0 || mode.vtotal == 0 {
+        return Duration::from_millis(16);
+    }
+
+    let millihertz = mode.dot_clock as u64 * 1_000 / (mode.htotal as u64 * mode.vtotal as u64);
+    let micros = 1_000_000_000 / millihertz;
+    log::info!("Refreshing every {}ms", micros / 1_000);
+    Duration::from_micros(micros)
+}
+
+/// Applies a mapped/obscured change to the refresh loop and reports the
+/// resulting visibility to the window. Consumes the client borrow because the
+/// visibility callback re-enters GPUI.
+fn handle_visibility_changed(mut state: RefMut<'_, X11ClientState>, x_window: xproto::Window) {
+    state.update_refresh_loop(x_window);
+    let Some(window_ref) = state.windows.get(&x_window) else {
+        return;
+    };
+    let visibility = window_ref.visibility();
+    let window = window_ref.window.clone();
+    drop(state);
+    window.set_visibility(visibility);
+}
+
+thread_local! {
+    /// The embedder's top-level whose pointer moves GPUI asked for, GPUI's window in it that they're
+    /// for, and that window's top left in the top-level, in pixels (`X11ClientState::watch_motion`).
+    static MOTION_OVER: std::cell::Cell<Option<(xproto::Window, xproto::Window, i16, i16)>> =
+        const { std::cell::Cell::new(None) };
+}
+
+fn fp3232_to_f32(value: xinput::Fp3232) -> f32 {
+    value.integral as f32 + value.frac as f32 / u32::MAX as f32
+}
+
+fn fp3232_to_f64(value: xinput::Fp3232) -> f64 {
+    f64::from(value.integral) + f64::from(value.frac) / (1u64 << 32) as f64
+}
+
+/// The modifiers a sent core event's state holds, as XInput 2 gives them.
+fn sent_modifiers(state: xproto::KeyButMask) -> xinput::ModifierInfo {
+    xinput::ModifierInfo {
+        effective: u32::from(u16::from(state) & 0xff),
+        ..Default::default()
+    }
+}
+
+/// The buttons a sent core event's state holds down, as XInput 2's mask has them: bit n for
+/// button n, where the core state's Button1 is bit 8.
+fn sent_buttons(state: xproto::KeyButMask) -> u32 {
+    u32::from((u16::from(state) >> 8) & 0x1f) << 1
+}
+
+/// A key the server sent the window under an overlay that has the keys goes to the overlay, as
+/// Wayland's do (`key_window`): one typed right after the key that asked for the overlay comes
+/// before the overlay has the input focus, even before GPUI has shown it.
+fn to_keyboard_overlay(event: Event) -> Event {
+    let overlay =
+        crate::linux::overlay::keyboard_overlay_asked().map(|view| view as xproto::Window);
+    match (event, overlay) {
+        (Event::KeyPress(mut key), Some(overlay)) => {
+            key.event = overlay;
+            Event::KeyPress(key)
+        }
+        (Event::KeyRelease(mut key), Some(overlay)) => {
+            key.event = overlay;
+            Event::KeyRelease(key)
+        }
+        (event, _) => event,
+    }
+}
+
+fn detect_compositor_gpu(
+    xcb_connection: &XCBConnection,
+    screen: &xproto::Screen,
+) -> Option<CompositorGpuHint> {
+    use std::os::fd::AsRawFd;
+    use std::os::unix::fs::MetadataExt;
+
+    xcb_connection
+        .extension_information(dri3::X11_EXTENSION_NAME)
+        .ok()??;
+
+    let reply = dri3::open(xcb_connection, screen.root, 0)
+        .ok()?
+        .reply()
+        .ok()?;
+    let fd = reply.device_fd;
+
+    let path = format!("/proc/self/fd/{}", fd.as_raw_fd());
+    let metadata = std::fs::metadata(&path).ok()?;
+
+    crate::linux::compositor_gpu_hint_from_dev_t(metadata.rdev())
+}
+
+fn check_compositor_present(xcb_connection: &XCBConnection, root: xproto::Window) -> bool {
+    // Method 1: Check for _NET_WM_CM_S{root}
+    let atom_name = format!("_NET_WM_CM_S{}", root);
+    let atom1 = get_reply(
+        || format!("Failed to intern {atom_name}"),
+        xcb_connection.intern_atom(false, atom_name.as_bytes()),
+    );
+    let method1 = match atom1.log_with_level(Level::Debug) {
+        Some(reply) if reply.atom != x11rb::NONE => {
+            let atom = reply.atom;
+            get_reply(
+                || format!("Failed to get {atom_name} owner"),
+                xcb_connection.get_selection_owner(atom),
+            )
+            .map(|reply| reply.owner != 0)
+            .log_with_level(Level::Debug)
+            .unwrap_or(false)
+        }
+        _ => false,
+    };
+
+    // Method 2: Check for _NET_WM_CM_OWNER
+    let atom_name = "_NET_WM_CM_OWNER";
+    let atom2 = get_reply(
+        || format!("Failed to intern {atom_name}"),
+        xcb_connection.intern_atom(false, atom_name.as_bytes()),
+    );
+    let method2 = match atom2.log_with_level(Level::Debug) {
+        Some(reply) if reply.atom != x11rb::NONE => {
+            let atom = reply.atom;
+            get_reply(
+                || format!("Failed to get {atom_name}"),
+                xcb_connection.get_property(false, root, atom, xproto::AtomEnum::WINDOW, 0, 1),
+            )
+            .map(|reply| reply.value_len > 0)
+            .unwrap_or(false)
+        }
+        _ => return false,
+    };
+
+    // Method 3: Check for _NET_SUPPORTING_WM_CHECK
+    let atom_name = "_NET_SUPPORTING_WM_CHECK";
+    let atom3 = get_reply(
+        || format!("Failed to intern {atom_name}"),
+        xcb_connection.intern_atom(false, atom_name.as_bytes()),
+    );
+    let method3 = match atom3.log_with_level(Level::Debug) {
+        Some(reply) if reply.atom != x11rb::NONE => {
+            let atom = reply.atom;
+            get_reply(
+                || format!("Failed to get {atom_name}"),
+                xcb_connection.get_property(false, root, atom, xproto::AtomEnum::WINDOW, 0, 1),
+            )
+            .map(|reply| reply.value_len > 0)
+            .unwrap_or(false)
+        }
+        _ => return false,
+    };
+
+    log::debug!(
+        "Compositor detection: _NET_WM_CM_S?={}, _NET_WM_CM_OWNER={}, _NET_SUPPORTING_WM_CHECK={}",
+        method1,
+        method2,
+        method3
+    );
+
+    method1 || method2 || method3
+}
+
+fn check_gtk_frame_extents_supported(
+    xcb_connection: &XCBConnection,
+    atoms: &XcbAtoms,
+    root: xproto::Window,
+) -> bool {
+    let Some(supported_atoms) = get_reply(
+        || "Failed to get _NET_SUPPORTED",
+        xcb_connection.get_property(
+            false,
+            root,
+            atoms._NET_SUPPORTED,
+            xproto::AtomEnum::ATOM,
+            0,
+            1024,
+        ),
+    )
+    .log_with_level(Level::Debug) else {
+        return false;
+    };
+
+    let supported_atom_ids: Vec<u32> = supported_atoms
+        .value
+        .chunks_exact(4)
+        .filter_map(|chunk| chunk.try_into().ok().map(u32::from_ne_bytes))
+        .collect();
+
+    supported_atom_ids.contains(&atoms._GTK_FRAME_EXTENTS)
+}
+
+fn xdnd_is_atom_supported(atom: u32, atoms: &XcbAtoms) -> bool {
+    atom == atoms.TEXT
+        || atom == atoms.STRING
+        || atom == atoms.UTF8_STRING
+        || atom == atoms.TEXT_PLAIN
+        || atom == atoms.TEXT_PLAIN_UTF8
+        || atom == atoms.TextUriList
+}
+
+fn xdnd_get_supported_atom(
+    xcb_connection: &XCBConnection,
+    supported_atoms: &XcbAtoms,
+    target: xproto::Window,
+) -> u32 {
+    if let Some(reply) = get_reply(
+        || "Failed to get XDnD supported atoms",
+        xcb_connection.get_property(
+            false,
+            target,
+            supported_atoms.XdndTypeList,
+            AtomEnum::ANY,
+            0,
+            1024,
+        ),
+    )
+    .log_with_level(Level::Warn)
+        && let Some(atoms) = reply.value32()
+    {
+        for atom in atoms {
+            if xdnd_is_atom_supported(atom, supported_atoms) {
+                return atom;
+            }
+        }
+    }
+    0
+}
