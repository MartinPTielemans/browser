+        if crate::linux::overlay::is_shown(focus as usize) {
+            return Ok(true);
+        }
+        let xcb = &self.xcb_connection;
+        let top = self.top_level(within)?;
+        let mut each = focus;
+        while each != top {
+            let tree = xcb.query_tree(each)?.reply()?;
+            if tree.parent == tree.root || tree.parent == x11rb::NONE {
