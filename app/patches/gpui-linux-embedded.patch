+/// With a layout that isn't Latin, the key as the keymap's Latin layout types it, as the user
+/// switched between them has it ("us,il"), else as US does. Ctrl's shortcuts match by it, as
+/// Chrome's and the Mac's do: Hebrew's key that types "א" is T, and the one that types "'" is W,
+/// though that's ASCII. None on a Latin layout, which keeps its own, and for a key that types no
+/// ASCII there.
+#[cfg(any(feature = "wayland", feature = "x11"))]
+fn latin_key(state: &State, keycode: Keycode, shift: bool) -> Option<String> {
+    let keymap = state.get_keymap();
+    let layout = state.key_get_layout(keycode);
+    if layout >= keymap.num_layouts() || is_latin(&keymap, layout) {
+        return None;
+    }
+    let key = match (0..keymap.num_layouts()).find(|&latin| is_latin(&keymap, latin)) {
+        Some(latin) => keymap
+            .key_get_syms_by_level(keycode, latin, state.key_get_level(keycode, latin))
+            .first()
+            .and_then(|&sym| char::from_u32(xkb::keysym_to_utf32(sym)))?,
+        None => guess_ascii(keycode, shift)?,
+    };
+    key.is_ascii_graphic()
+        .then(|| key.to_ascii_lowercase().to_string())
+}
