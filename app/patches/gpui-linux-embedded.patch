+    fn top_level(&self, window: xproto::Window) -> anyhow::Result<xproto::Window> {
+        let mut top = window;
+        loop {
+            let tree = self.xcb_connection.query_tree(top)?.reply()?;
+            if tree.parent == tree.root || tree.parent == x11rb::NONE {
+                return Ok(top);
