+        window.set_focused(true);
+    }
+    refresh_embedded_text_input_of(&window);
+    flush(&window);
+    Ok(())
+}
+
+pub(crate) fn move_overlay(view: *mut std::ffi::c_void, bounds: Bounds<Pixels>) {
+    if let Some(window) = overlay_window(view) {
+        window.move_over(bounds);
+        refresh_embedded_text_input_of(&window);
+        flush(&window);
+    }
+}
+
+/// Stacks the overlay window of the `under` surface directly under that of `over`, both showing.
+pub(crate) fn place_overlay_under(under: *mut std::ffi::c_void, over: *mut std::ffi::c_void) {
+    if let (Some(window), Some(above)) = (overlay_window(under), overlay_window(over)) {
+        window.place_under(&above);
+        flush(&window);
+    }
+}
+
+/// The overlay window of the `view` surface takes the pointer only in `areas`, or all over.
+pub(crate) fn overlay_pointer(view: *mut std::ffi::c_void, areas: Option<&[Bounds<Pixels>]>) {
+    // Not through a WaylandWindow, whose drop would close the window.
+    if let Some(window) = overlay_window(view) {
+        window.set_input_region(areas);
+        flush(&window);
+    }
+}
+
+/// The overlay window of the `view` surface that shows takes the keys, or gives them back.
+pub(crate) fn overlay_keyboard(view: *mut std::ffi::c_void, keyboard: bool) {
+    if let Some(window) = overlay_window(view) {
+        window.set_focused(keyboard);
+        refresh_embedded_text_input_of(&window);
+    }
+}
+
+/// Shows the window of the `view` surface, opened with `show: false`, as a toplevel of its own
+/// (`crate::linux::show_window`).
+pub(crate) fn show_window(view: *mut std::ffi::c_void) -> anyhow::Result<()> {
+    let window = overlay_window(view).context("no window has the surface")?;
+    window.show_toplevel()?;
+    flush(&window);
+    Ok(())
+}
+
+pub(crate) fn hide_window(view: *mut std::ffi::c_void) {
+    if let Some(window) = overlay_window(view) {
+        window.hide_toplevel();
+        flush(&window);
+    }
+}
+
+pub(crate) fn hide_overlay(view: *mut std::ffi::c_void, keyboard: bool) {
+    if let Some(window) = overlay_window(view) {
+        if keyboard {
+            window.set_focused(false);
+        }
+        let parent = window.embedder_surface();
+        window.hide_over();
+        if let Some((parent, _)) = parent {
+            refresh_embedded_text_input(parent);
+        }
+        flush(&window);
+    }
+}
