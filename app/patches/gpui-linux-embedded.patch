+/// The rows of the polygon through `corners`, each x, y and the radius it's rounded by, in device
+/// pixels, for a shape `height` rows tall: each row's spans through the middle of its pixels, or,
+/// `touching`, with every pixel the polygon touches, so that the edges GPUI smooths are inside it.
+fn outline_rows(corners: &[(f32, f32, f32)], height: i16, touching: bool) -> Vec<xproto::Rectangle> {
+    let points = rounded_polygon(corners);
+    let spans = |y: f32| {
+        let mut crossings: Vec<f32> = (points.iter())
+            .zip(points.iter().cycle().skip(1))
+            .filter(|(a, b)| (a.1 <= y) != (b.1 <= y))
+            .map(|(a, b)| a.0 + (y - a.1) / (b.1 - a.1) * (b.0 - a.0))
+            .collect();
+        crossings.sort_by(f32::total_cmp);
+        crossings
+    };
+    let mut rows = Vec::new();
+    for row in 0..height {
+        // Across the row, top to bottom; its middle's alone where the spans come apart in it.
+        let samples = [0.01, 0.5, 0.99].map(|at| spans(row as f32 + at));
+        let middle = &samples[1];
+        let whole = touching && samples.iter().all(|each| each.len() == middle.len());
+        let crossings: Vec<f32> = match whole {
+            true => (0..middle.len())
+                .map(|index| {
+                    let all = samples.iter().map(|each| each[index]);
+                    match index % 2 {
+                        0 => all.fold(f32::MAX, f32::min).floor(),
+                        _ => all.fold(f32::MIN, f32::max).ceil(),
+                    }
+                })
+                .collect(),
+            false => middle.iter().map(|x| x.round()).collect(),
+        };
+        for span in crossings.chunks_exact(2) {
+            let (left, right) = (span[0] as i16, span[1] as i16);
+            if right > left {
+                rows.push(xproto::Rectangle {
+                    x: left,
+                    y: row,
+                    width: (right - left) as u16,
+                    height: 1,
+                });
+            }
+        }
+    }
+    rows
+}
+
+/// The polygon through `corners` with each rounded by its radius, its arcs in short lines.
+fn rounded_polygon(corners: &[(f32, f32, f32)]) -> Vec<(f32, f32)> {
+    let count = corners.len();
+    let at = |index: usize| (corners[index % count].0, corners[index % count].1);
+    let mut points = Vec::new();
+    for index in 0..count {
+        let here = at(index);
+        let radius = corners[index].2;
+        let unit = |to: (f32, f32)| {
+            let (dx, dy) = (to.0 - here.0, to.1 - here.1);
+            let length = dx.hypot(dy).max(f32::EPSILON);
+            (dx / length, dy / length)
+        };
+        let (before, after) = (unit(at(index + count - 1)), unit(at(index + 1)));
+        // The arc meets each side as far along it as the radius over the tangent of half the angle
+        // between them, and its centre is on the line halving that angle.
+        let half = (before.0 * after.0 + before.1 * after.1)
+            .clamp(-1., 1.)
+            .acos()
+            / 2.;
+        let (bx, by) = (before.0 + after.0, before.1 + after.1);
+        let bisector = bx.hypot(by);
+        if radius <= 0. || bisector < 1e-4 {
+            points.push(here);
+            continue;
+        }
+        let along = radius / half.tan();
+        let distance = radius / half.sin();
+        let centre = (
+            here.0 + bx / bisector * distance,
+            here.1 + by / bisector * distance,
+        );
+        let angle = |point: (f32, f32)| (point.1 - centre.1).atan2(point.0 - centre.0);
+        let start = angle((here.0 + before.0 * along, here.1 + before.1 * along));
+        let end = angle((here.0 + after.0 * along, here.1 + after.1 * along));
+        let mut sweep = end - start;
+        if sweep > std::f32::consts::PI {
+            sweep -= std::f32::consts::TAU;
+        } else if sweep < -std::f32::consts::PI {
+            sweep += std::f32::consts::TAU;
+        }
+        // Within about a tenth of a pixel of the arc.
+        let steps = (radius.sqrt() * 2.).ceil().max(2.) as usize;
+        for step in 0..=steps {
+            let a = start + sweep * step as f32 / steps as f32;
+            points.push((centre.0 + radius * a.cos(), centre.1 + radius * a.sin()));
+        }
+    }
+    points
+}
