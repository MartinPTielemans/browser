+                    match index % 2 {
+                        0 => all.fold(f32::MAX, f32::min).floor(),
+                        _ => all.fold(f32::MIN, f32::max).ceil(),
+                    }
+                })
+                .collect(),
+            false => middle.iter().map(|x| x.round()).collect(),
