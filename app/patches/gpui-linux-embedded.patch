+/// GPUI's window in the embedder's surface `surface_id`, which the compositor gives the keyboard
+/// to rather than the subsurface.
+fn embedded_window_in(
+    state: &RefMut<WaylandClientState>,
+    surface_id: &ObjectId,
+) -> Option<WaylandWindowStatePtr> {
+    let parent = surface_id.as_ptr().cast::<std::ffi::c_void>();
+    (state.windows.values())
+        .find(|window| window.embedded_parent() == Some(parent))
+        .cloned()
