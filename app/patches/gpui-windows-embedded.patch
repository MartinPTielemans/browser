+pub(crate) static EMBEDDED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Lets an embedder that runs the thread's message loop, such as a browser engine, run GPUI:
+/// `Application::run_embedded` returns once GPUI has launched, rather than running a loop of its
+/// own, and windows take their key presses from the embedder's dispatch. Call it before starting.
+pub fn embed() {
+    EMBEDDED.store(true, std::sync::atomic::Ordering::Relaxed);
+}
