+thread_local! {
+    /// The canvas the page gave `draw_in`, and whether a graphics context has taken it.
+    static PAGE_CANVAS: RefCell<Option<(web_sys::HtmlCanvasElement, bool)>> = const { RefCell::new(None) };
+}
+
+/// Draws the app's window in `canvas`, where the page put it and at the size the page gives it,
+/// rather than in a canvas of its own over the whole page. Call it before the app runs.
+pub fn draw_in(canvas: web_sys::HtmlCanvasElement) {
+    PAGE_CANVAS.with_borrow_mut(|page| *page = Some((canvas, false)));
+}
+
+/// Whether `canvas` is the page's, which stays in the page when a backend fails on it.
+pub(crate) fn is_page_canvas(canvas: &web_sys::HtmlCanvasElement) -> bool {
+    PAGE_CANVAS.with_borrow(|page| page.as_ref().is_some_and(|(page, _)| page == canvas))
+}
+
+/// Whether the page gave `draw_in` a canvas.
+pub(crate) fn draws_in_page_canvas() -> bool {
+    PAGE_CANVAS.with_borrow(Option::is_some)
+}
+
+/// Gives the page's canvas back untaken when no context was asked of it, so WebGL2 draws in the
+/// canvas the page holds, as it does wherever the browser has no WebGPU adapter.
+pub(crate) fn untake_page_canvas() {
+    PAGE_CANVAS.with_borrow_mut(|page| {
+        if let Some((_, taken)) = page {
+            *taken = false;
+        }
+    });
+}
+
+/// The page's canvas, set up for input, or None if the page gave none. A canvas WebGPU has taken
+/// can't take WebGL2, so a second ask puts a copy of it, with its id and style, in its place.
+fn page_canvas() -> anyhow::Result<Option<web_sys::HtmlCanvasElement>> {
+    let Some((canvas, taken)) = PAGE_CANVAS.with_borrow(|page| page.clone()) else {
+        return Ok(None);
+    };
+    let canvas = if taken {
+        let copy: web_sys::HtmlCanvasElement = canvas
+            .clone_node()
+            .map_err(|error| anyhow::anyhow!("Failed to copy the page's canvas: {error:?}"))?
+            .dyn_into()
+            .map_err(|error| anyhow::anyhow!("The copy is not a canvas: {error:?}"))?;
+        canvas
+            .replace_with_with_node_1(&copy)
+            .map_err(|error| anyhow::anyhow!("Failed to replace the page's canvas: {error:?}"))?;
+        copy
+    } else {
+        canvas
+    };
+    PAGE_CANVAS.with_borrow_mut(|page| *page = Some((canvas.clone(), true)));
+    canvas.set_tab_index(-1);
+    let style = canvas.style();
+    for (property, value) in [
+        ("outline", "none"),
+        ("touch-action", "none"),
+        ("-webkit-touch-callout", "none"),
+        ("user-select", "none"),
+        ("-webkit-user-select", "none"),
+    ] {
+        style.set_property(property, value).map_err(|error| {
+            anyhow::anyhow!("Failed to set canvas {property} style: {error:?}")
+        })?;
+    }
+    Ok(Some(canvas))
+}
