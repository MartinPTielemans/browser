     /// Records the new drawable size and reconfigures the surface when one is present.
     /// The size is kept even without GPU resources so that recovery restores it.
+    /// Resizes the surface unless the GPU still has work in flight, which WebGL can't wait for
+    /// within a task: wgpu's reconfigure would then panic. Returns false when it waited, for the
+    /// caller to try again next frame. Browser WebGPU always reports its queue empty.
+    pub fn try_update_drawable_size(&mut self, size: Size<DevicePixels>) -> bool {
+        #[cfg(target_family = "wasm")]
+        if let Some(core) = self.core() {
+            let idle = core
+                .resources
+                .device
+                .poll(wgpu::PollType::Poll)
+                .is_ok_and(|status| status.is_queue_empty());
+            if !idle {
+                return false;
+            }
+        }
+        self.update_drawable_size(size);
+        true
+    }
