+    fn scale_about(&mut self, factor: f32, origin: Point<ScaledPixels>) {
+        let length = |length: &ScaledPixels| *length * factor;
+        let at = |p: Point<ScaledPixels>| {
+            point(
+                origin.x + (p.x - origin.x) * factor,
+                origin.y + (p.y - origin.y) * factor,
+            )
+        };
