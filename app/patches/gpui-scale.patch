+    /// Scales what `f` paints by `factor` about `origin`, as a layer's transform would: sizes,
+    /// text and images with it. Layout and hit testing don't change, and the masks of elements
+    /// around `f` are scaled with what it paints. It doesn't nest. This method should only be
+    /// called as part of the paint phase of element drawing.
+    pub fn with_scale<R>(
+        &mut self,
+        factor: f32,
+        origin: Point<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint();
+        debug_assert!(self.next_frame.scene.scale.is_none(), "with_scale doesn't nest");
+        let origin = origin.scale(self.scale_factor());
+        self.next_frame.scene.scale = Some((factor, origin));
+        let result = f(self);
+        self.next_frame.scene.scale = None;
+        result
+    }
