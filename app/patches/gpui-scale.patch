+    /// Scales the primitive by `factor` about `origin`, as a layer's transform would.
+    fn scale_about(&mut self, factor: f32, origin: Point<ScaledPixels>) {
+        let length = |length: &ScaledPixels| *length * factor;
+        let at = |p: Point<ScaledPixels>| {
+            point(
+                origin.x + (p.x - origin.x) * factor,
+                origin.y + (p.y - origin.y) * factor,
+            )
+        };
+        let bounds = |bounds: &mut Bounds<ScaledPixels>| {
+            *bounds = Bounds {
+                origin: at(bounds.origin),
+                size: bounds.size.map(|side| side * factor),
+            };
+        };
+        let mask = |mask: &mut ContentMask<ScaledPixels>| bounds(&mut mask.bounds);
+        // A sprite's own transformation applies to its scaled bounds, so it's conjugated.
+        let transformation = |transformation: &mut TransformationMatrix| {
+            if *transformation == TransformationMatrix::unit() {
+                return;
+            }
+            let scale = |factor: f32, origin: Point<ScaledPixels>| {
+                TransformationMatrix::unit()
+                    .translate(origin)
+                    .scale(Size::new(factor, factor))
+                    .translate(point(ScaledPixels(-origin.x.0), ScaledPixels(-origin.y.0)))
+            };
+            *transformation = scale(factor, origin)
+                .compose(*transformation)
+                .compose(scale(1. / factor, origin));
+        };
+        match self {
+            Primitive::Shadow(shadow) => {
+                shadow.blur_radius = length(&shadow.blur_radius);
+                bounds(&mut shadow.bounds);
+                shadow.corner_radii = shadow.corner_radii.map(length);
+                mask(&mut shadow.content_mask);
+                bounds(&mut shadow.element_bounds);
+                shadow.element_corner_radii = shadow.element_corner_radii.map(length);
+            }
+            Primitive::Quad(quad) => {
+                bounds(&mut quad.bounds);
+                mask(&mut quad.content_mask);
+                quad.corner_radii = quad.corner_radii.map(length);
+                quad.border_widths = quad.border_widths.map(length);
+            }
+            Primitive::Path(path) => {
+                bounds(&mut path.bounds);
+                mask(&mut path.content_mask);
+                for vertex in &mut path.vertices {
+                    vertex.xy_position = at(vertex.xy_position);
+                    mask(&mut vertex.content_mask);
+                }
+            }
+            Primitive::Underline(underline) => {
+                bounds(&mut underline.bounds);
+                mask(&mut underline.content_mask);
+                underline.thickness = length(&underline.thickness);
+            }
+            Primitive::MonochromeSprite(sprite) => {
+                bounds(&mut sprite.bounds);
+                mask(&mut sprite.content_mask);
+                transformation(&mut sprite.transformation);
+            }
+            Primitive::SubpixelSprite(sprite) => {
+                bounds(&mut sprite.bounds);
+                mask(&mut sprite.content_mask);
+                transformation(&mut sprite.transformation);
+            }
+            Primitive::PolychromeSprite(sprite) => {
